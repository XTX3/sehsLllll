/* ===== نسخ الوصف بضغطة مطولة (موبايل) أو كليك يمين (ديسكتوب) ===== */
let longPressTimer = null;
function startLongPress(pid){
  longPressTimer = setTimeout(() => {
    const descEl = document.getElementById(`desc-${pid}`);
    if(!descEl) return;
    navigator.clipboard.writeText(descEl.textContent.trim()).then(() => {
      showCopyToast();
    }).catch(() => {
      // fallback
      const ta = document.createElement('textarea');
      ta.value = descEl.textContent.trim();
      document.body.appendChild(ta);
      ta.select(); document.execCommand('copy');
      document.body.removeChild(ta);
      showCopyToast();
    });
  }, 600);
}
function clearLongPress(){ clearTimeout(longPressTimer); }
function copyPostDesc(e, pid){
  e.preventDefault();
  const descEl = document.getElementById(`desc-${pid}`);
  if(!descEl) return;
  navigator.clipboard.writeText(descEl.textContent.trim()).then(showCopyToast).catch(()=>{});
}
function showCopyToast(){
  const t = document.createElement('div');
  t.style.cssText = 'position:fixed;bottom:90px;left:50%;transform:translateX(-50%);background:#1a1a2e;color:white;padding:10px 20px;border-radius:30px;font-family:Cairo,sans-serif;font-size:13px;font-weight:700;z-index:9999;animation:dropDown 0.3s ease;display:flex;align-items:center;gap:7px;';
  t.innerHTML = '<i class="fa fa-copy" style="color:var(--highlight);"></i> تم نسخ النص';
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 2000);
}

