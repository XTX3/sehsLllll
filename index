.add-winner-header h3 { color:white; font-weight:900; font-size:17px; }
.add-winner-close { background:rgba(255,255,255,0.2); border:none; color:white; width:34px; height:34px; border-radius:10px; font-size:16px; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:all 0.3s; }
.add-winner-close:hover { transform:rotate(90deg); }
.add-winner-body { padding:20px; }
.add-winner-body input, .add-winner-body textarea { width:100%; padding:11px 14px; border-radius:12px; border:1.5px solid #e8e8e8; font-family:'Cairo',sans-serif; font-size:14px; outline:none; margin-bottom:10px; transition:border 0.3s; box-sizing:border-box; }
.add-winner-body input:focus, .add-winner-body textarea:focus { border-color:#f39c12; }
.btn-save-winner { width:100%; padding:13px; border:none; border-radius:14px; background:linear-gradient(135deg,#f39c12,#e67e22); color:white; font-weight:900; font-family:'Cairo',sans-serif; font-size:15px; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:8px; }
#addGroupModal { display:none; position:fixed; inset:0; z-index:9998; justify-content:center; align-items:center; background:rgba(0,0,0,0.55); backdrop-filter:blur(5px); padding:20px; }
#addGroupModal.open { display:flex; }
.add-group-box { background:white; border-radius:20px; width:100%; max-width:360px; overflow:hidden; animation:popIn 0.3s ease; }
.add-group-header { background:linear-gradient(135deg,var(--primary),var(--accent)); padding:16px 18px; display:flex; align-items:center; justify-content:space-between; }
.add-group-header h4 { color:white; font-weight:900; font-size:16px; }
.add-group-close { background:rgba(255,255,255,0.15); border:none; color:white; width:32px; height:32px; border-radius:50%; font-size:14px; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:all 0.3s; }
.add-group-close:hover { transform:rotate(90deg); }
.add-group-body { padding:18px; }
.add-group-body input { width:100%; padding:11px 14px; border-radius:12px; border:1.5px solid #e8e8e8; font-family:'Cairo',sans-serif; font-size:14px; outline:none; margin-bottom:12px; transition:border 0.3s; box-sizing:border-box; }
.add-group-body input:focus { border-color:var(--accent); }
.btn-save-group { width:100%; padding:12px; border:none; border-radius:12px; background:linear-gradient(135deg,var(--primary),var(--accent)); color:white; font-weight:900; font-family:'Cairo',sans-serif; font-size:14px; cursor:pointer; }

/* زر أدمن على بطاقة الهاتف */
.ph-card-admin-btn {
  position:absolute; top:8px; left:8px; z-index:10;
  background:rgba(0,0,0,0.45); border:none; color:white;
  width:30px; height:30px; border-radius:9px; font-size:13px;
  cursor:pointer; display:flex; align-items:center; justify-content:center;
  backdrop-filter:blur(4px); transition:all 0.2s;
}
.ph-card-admin-btn:hover { background:rgba(0,0,0,0.7); }
.ph-card-admin-dropdown {
  display:none; position:absolute; top:42px; left:8px;
  background:white; border-radius:12px; overflow:hidden;
  box-shadow:0 8px 24px rgba(0,0,0,0.18); z-index:20; min-width:130px;
}
.ph-card-admin-dropdown.open { display:block; animation:popIn 0.18s ease; }
.ph-card-admin-item {
  padding:11px 14px; font-size:13px; font-weight:700; font-family:'Cairo',sans-serif;
  cursor:pointer; display:flex; align-items:center; gap:8px;
  color:var(--primary); transition:background 0.2s;
}
.ph-card-admin-item:hover { background:#f5f5f5; }
.ph-card-admin-item.danger { color:#e94560; }
.ph-card-admin-item.danger:hover { background:#fff0f3; }

/* ===== نافذة يجب تسجيل الدخول ===== */
#loginRequiredModal {
  display:none; position:fixed; inset:0; z-index:99999;
  justify-content:center; align-items:center;
  background:rgba(0,0,0,0.6); backdrop-filter:blur(6px); padding:20px;
}
#loginRequiredModal.open { display:flex; animation:fadeInBg 0.3s ease; }
@keyframes fadeInBg { from{opacity:0;} to{opacity:1;} }
.login-required-box {
  background:white; border-radius:28px; width:100%; max-width:360px;
  overflow:hidden; animation:popIn 0.35s cubic-bezier(0.175,0.885,0.32,1.275);
  box-shadow:0 24px 60px rgba(0,0,0,0.25);
}
.login-required-top {
  background:linear-gradient(135deg,var(--primary) 0%,var(--accent) 100%);
  padding:32px 24px 24px; text-align:center;
}
.login-required-icon {
  width:72px; height:72px; border-radius:50%;
  background:rgba(255,255,255,0.15); border:2px solid rgba(255,255,255,0.3);
  display:flex; align-items:center; justify-content:center;
  margin:0 auto 14px; font-size:30px; color:white;
}
.login-required-top h3 { color:white; font-weight:900; font-size:19px; margin-bottom:6px; }
.login-required-top p { color:rgba(255,255,255,0.75); font-size:13px; line-height:1.6; }
.login-required-bottom { padding:20px; display:flex; flex-direction:column; gap:10px; }
.btn-go-login {
  width:100%; padding:14px; border:none; border-radius:14px;
  background:linear-gradient(135deg,var(--primary),var(--accent));
  color:white; font-weight:900; font-family:'Cairo',sans-serif;
  font-size:15px; cursor:pointer; transition:all 0.3s;
  display:flex; align-items:center; justify-content:center; gap:8px;
}
.btn-go-login:hover { opacity:0.9; transform:translateY(-1px); }
.btn-go-register {
  width:100%; padding:13px; border:2px solid #e8e8e8; border-radius:14px;
  background:white; color:var(--primary); font-weight:900; font-family:'Cairo',sans-serif;
  font-size:15px; cursor:pointer; transition:all 0.3s;
