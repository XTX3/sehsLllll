function onDepAmountChange() {
  const amt     = parseFloat(document.getElementById('depAmount').value) || 0;
  const finalBox = document.getElementById('depFinalBox');
  const finalUsd = document.getElementById('depFinalUsd');
  const finalNote= document.getElementById('depFinalNote');

  if (amt <= 0) {
    finalBox.style.display = 'none';
    return;
  }

  finalBox.style.display = 'block';
  if (depCurrency === 'usd') {
    finalUsd.textContent  = amt.toFixed(3) + ' $';
    finalNote.textContent = '';
  } else {
    const dollars = (amt / depSyRate).toFixed(3);
    finalUsd.textContent  = dollars + ' $';
    finalNote.textContent = amt.toLocaleString() + ' ل.س ÷ ' + depSyRate.toLocaleString() + ' = ' + dollars + ' $';
  }
}

function copyDepCode() {
  const code = document.getElementById('depShamcashCode').textContent;
  if (!code || code === 'لم يُحدد بعد') { showToast('الكود غير متوفر حالياً','warning'); return; return; }
  navigator.clipboard.writeText(code).then(() => {
    const btn = document.querySelector('.dep-code-copy');
    const orig = btn.innerHTML;
    btn.innerHTML = '<i class="fa fa-check"></i> تم النسخ';
    setTimeout(() => { btn.innerHTML = orig; }, 2000);
  }).catch(() => {
    // fallback
    const el = document.createElement('textarea');
    el.value = code;
    document.body.appendChild(el);
    el.select();
    document.execCommand('copy');
    document.body.removeChild(el);
    showToast('تم نسخ الكود','success');
  });
}

async function submitDeposit() {
  if (!auth.currentUser) return;
  const amtRaw    = parseFloat(document.getElementById('depAmount').value)    || 0;
  const txId      = document.getElementById('depTxId').value.trim();
  const senderName= document.getElementById('depSenderName').value.trim();

  if (amtRaw <= 0)    { showToast('يرجى إدخال المبلغ','warning'); return; return; }
  if (!txId)          { showToast('يرجى إدخال رقم الحوالة','warning'); return; return; }
  if (!senderName)    { showToast('يرجى إدخال اسم الحساب المُرسِل','warning'); return; return; }

  const btn = document.getElementById('depSubmitBtn');
  btn.disabled = true;
  btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> جاري الإرسال...';

  // حساب المبلغ بالدولار
  let amountUsd;
  let amountDisplay;
  if (depCurrency === 'usd') {
    amountUsd     = Math.round(amtRaw * 1000) / 1000;
    amountDisplay = `${amountUsd.toFixed(3)} $`;
  } else {
    amountUsd     = Math.round((amtRaw / depSyRate) * 1000) / 1000;
    amountDisplay = `${amtRaw.toLocaleString()} ل.س (≈ ${amountUsd.toFixed(3)} $)`;
  }

  try {
    const uid = auth.currentUser.uid;
    const userDoc = await db.collection('users').doc(uid).get();
    const uInfo   = userDoc.data() || {};

    await db.collection('depositRequests').add({
      uid,
      name        : uInfo.name || auth.currentUser.email,
      email       : auth.currentUser.email,
      photo       : uInfo.photo || '',
      topupCode   : uInfo.topupCode || '—',
      method      : 'shamcash',
      currency    : depCurrency,
      amountRaw   : amtRaw,
      amountUsd,
      amountDisplay,
      syRate      : depCurrency === 'syp' ? depSyRate : null,
      txId,
      senderName,
      status      : 'pending',
      createdAt   : firebase.firestore.FieldValue.serverTimestamp()
    });

    btn.disabled = false;
    btn.innerHTML = '<i class="fa fa-paper-plane"></i> إرسال طلب الإيداع';
    closeDepositModal();

    // رسالة نجاح
    const msg = document.createElement('div');
    msg.style.cssText = 'position:fixed;top:80px;left:50%;transform:translateX(-50%);background:white;border-radius:16px;padding:14px 20px;box-shadow:0 8px 30px rgba(0,0,0,0.15);z-index:9999;display:flex;align-items:center;gap:10px;font-family:Cairo,sans-serif;font-weight:700;font-size:14px;color:var(--primary);animation:dropDown 0.3s ease;max-width:340px;width:calc(100% - 40px);';
    msg.innerHTML = '<i class="fa fa-check-circle" style="color:#16a085;font-size:20px;"></i><div><div>تم إرسال طلب الإيداع ✅</div><div style="font-size:12px;color:#aaa;font-weight:600;margin-top:2px;">سيتم مراجعته وإضافة رصيدك قريباً</div></div>';
    document.body.appendChild(msg);
    setTimeout(() => { if(msg.parentNode) msg.remove(); }, 4000);

  } catch(e) {
    showToast('خطأ: ' + e.message,'error');
    btn.disabled = false;
    btn.innerHTML = '<i class="fa fa-paper-plane"></i> إرسال طلب الإيداع';
  }
}

