function filterStore(type, el){
  storeCurrentFilter = type;
  document.querySelectorAll('.store-tab').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
  renderStoreGrid(type);
}

function renderStoreGrid(filter){
  const grid = document.getElementById('storeGrid');
  let filtered = filter === 'all' ? storeProducts : storeProducts.filter(function(p){ return p.type === filter; });

  // ترتيب المنتجات حسب النوع عند عرض الكل
  if (filter === 'all') {
    const typeOrder = ['electricity','shamcash','game','voice','balance','followers'];
    filtered = [...filtered].sort((a, b) => {
      const ai = typeOrder.indexOf(a.type), bi = typeOrder.indexOf(b.type);
      const aIdx = ai === -1 ? 99 : ai, bIdx = bi === -1 ? 99 : bi;
      if (aIdx !== bIdx) return aIdx - bIdx;
      const at = a.createdAt ? a.createdAt.toMillis() : 0;
      const bt = b.createdAt ? b.createdAt.toMillis() : 0;
      return at - bt;
    });
  }

  if(filtered.length === 0){
    grid.innerHTML = '';
    const empty = document.createElement('div');
    empty.style.cssText = 'grid-column:1/-1;text-align:center;padding:40px 20px;color:#bbb;';
    empty.innerHTML = '<i class="fa fa-store" style="font-size:40px;display:block;margin-bottom:12px;"></i><p style="font-size:14px;">لا توجد منتجات في هذا القسم</p>';
    grid.appendChild(empty);
    return;
  }

  grid.innerHTML = '';
  let lastType = null;
  filtered.forEach(function(p){
    if (filter === 'all' && p.type !== lastType) {
      lastType = p.type;
      const sep = document.createElement('div');
      sep.style.cssText = 'grid-column:1/-1;display:flex;align-items:center;gap:10px;margin:6px 0 2px;';
      sep.innerHTML = `<span style="font-weight:900;color:var(--primary);font-size:14px;">${TYPE_LABELS[p.type]||p.type}</span><div style="flex:1;height:1.5px;background:#e8e8e8;border-radius:2px;"></div>`;
      grid.appendChild(sep);
    }
    const tc = TYPE_COLORS[p.type] || '#888';
    const card = document.createElement('div');
    card.className = 'store-card';

    // Header image or colored icon
    let header;
    if(p.image){
      header = document.createElement('img');
      header.className = 'store-card-img';
      header.src = p.image;
      header.onerror = function(){ this.style.display='none'; };
    } else {
      header = document.createElement('div');
      header.className = 'store-card-icon';
      header.style.background = 'linear-gradient(135deg,' + (p.color1||'#1a1a2e') + ',' + (p.color2||'#0f3460') + ')';
      const ico = document.createElement('i');
      ico.className = 'fa ' + (p.icon || 'fa-store');
      header.appendChild(ico);
    }

    // Body
    const body = document.createElement('div');
    body.className = 'store-card-body';

    const nameEl = document.createElement('div');
    nameEl.className = 'store-card-name';
    nameEl.textContent = p.name || '';

    const subEl = document.createElement('div');
    subEl.className = 'store-card-sub';
    subEl.textContent = p.packages ? p.packages.length + ' باقات' : '';

    const badge = document.createElement('span');
    badge.className = 'store-card-type-badge';
    badge.style.background = tc + '22';
    badge.style.color = tc;
    badge.textContent = TYPE_LABELS[p.type] || p.type || '';

    body.appendChild(nameEl);
    body.appendChild(subEl);
    body.appendChild(badge);

    card.appendChild(header);
    card.appendChild(body);

    // حالة الإيقاف
    if (p.paused) {
      card.classList.add('paused');
      const pausedBadge = document.createElement('div');
      pausedBadge.className = 'paused-badge';
      pausedBadge.innerHTML = '⏸ غير متوفر حالياً';
      header.style.position = 'relative';
      header.appendChild(pausedBadge);
    }

    // لا يوجد زر ثلاث نقاط — التعديل من داخل النافذة

    (function(pid, isPaused){
      card.onclick = function(){
        if (isPaused && !(auth.currentUser && auth.currentUser.email === ADMIN_EMAIL)) {
          // للزوار والأعضاء: رسالة غير متوفر
          showProductUnavailable();
        } else {
          openStoreProduct(pid);
        }
      };
    })(p.id, !!p.paused);

    grid.appendChild(card);
  });
}


