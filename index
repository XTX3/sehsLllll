async function searchForModerator() {
  const val = document.getElementById('modSearchInput').value.trim();
  if (!val) { showToast('أدخل البريد الإلكتروني أو كود الشحن','warning'); return; return; }

  const resultEl = document.getElementById('modSearchResult');
  resultEl.style.display = 'block';
  resultEl.innerHTML = '<div style="text-align:center;padding:14px;"><i class="fa fa-spinner fa-spin" style="font-size:24px;color:#9b59b6;"></i></div>';

  try {
    const allUsers = await db.collection('users').get();
    let found = null;
    const searchVal = val.toLowerCase();
    allUsers.forEach(doc => {
      if (found) return;
      const u = doc.data();
      if ((u.email && u.email.toLowerCase() === searchVal) ||
          (u.topupCode && u.topupCode.toLowerCase() === searchVal)) {
        found = { id: doc.id, ...u };
      }
    });

    if (!found) {
      resultEl.innerHTML = '<div style="text-align:center;padding:14px;color:#e94560;font-size:13px;font-weight:700;">لم يتم العثور على هذا العضو</div>';
      return;
    }

    if (found.email === ADMIN_EMAIL) {
      resultEl.innerHTML = '<div style="text-align:center;padding:14px;color:#e94560;font-size:13px;font-weight:700;">لا يمكن تعديل صلاحيات الأدمن الرئيسي</div>';
      return;
    }

    modFoundUser = found;
    const photo = found.photo || 'https://cdn-icons-png.flaticon.com/512/3135/3135715.png';
    const isMod = found.role === 'moderator';
    const roleColors = { admin:'#f39c12', moderator:'#9b59b6', user:'#aaa' };
    const roleLabels = { admin:'أدمن', moderator:'مشرف', user:'عضو' };

    resultEl.innerHTML = `
      <div class="mod-result-card">
        <img src="${found.photo || photo}" onerror="this.src='${photo}'">
        <div class="mod-result-info">
          <div class="mod-result-name">${found.name || '—'}</div>
          <div class="mod-result-email">${found.email}</div>
          <div class="mod-result-role" style="color:${roleColors[found.role]||'#aaa'};">
            ${roleLabels[found.role]||'عضو'}
          </div>
          <div style="display:flex;gap:8px;margin-top:6px;flex-wrap:wrap;">
            <span style="background:rgba(0,212,170,0.1);border:1px solid rgba(0,212,170,0.3);border-radius:8px;padding:3px 8px;font-size:11px;font-weight:700;color:var(--highlight);">
              ${found.balance||'0.000'} $
            </span>
            <span style="background:#f0f0f0;border-radius:8px;padding:3px 8px;font-size:11px;font-weight:700;color:var(--primary);font-family:monospace;">
              ${found.topupCode||'—'}
            </span>
          </div>
        </div>
      </div>
      <div class="mod-action-btns">
        ${!isMod ? `
        <button class="btn-make-mod" onclick="setModerator('${found.id}', true)">
          <i class="fa fa-shield-halved"></i> تعيين مشرفاً
        </button>` : `
        <button class="btn-remove-mod" onclick="setModerator('${found.id}', false)">
          <i class="fa fa-user-slash"></i> إلغاء صلاحيات المشرف
        </button>`}
      </div>`;
  } catch(err) {
    resultEl.innerHTML = `<div style="text-align:center;padding:14px;color:#e94560;font-size:13px;">خطأ: ${err.message}</div>`;
  }
}

