      return `<label class="sp-field-label"><i class="fa ${f.icon}" style="color:var(--accent);margin-left:4px;"></i> ${f.label}</label>
        <select class="sp-field-input" id="${f.id}" style="appearance:auto;">
          <option value="">— لا شيء —</option>
          ${f.options.map(o => `<option value="${o}">${o}</option>`).join('')}
        </select>`;
    } else if(f.type === 'water_select'){
      // حقل المياه الخاص مع الأسعار
      const optionsHtml = f.options.map(o =>
        `<option value="${o.label}" data-price="${o.price}">${o.label} — ${o.price.toFixed(3)} $</option>`
      ).join('');
      return `<label class="sp-field-label"><i class="fa ${f.icon}" style="color:#3498db;margin-left:4px;"></i> ${f.label}</label>
        <select class="sp-field-input" id="${f.id}" style="appearance:auto;" onchange="onWaterSelect(this)">
          <option value="" data-price="0">— بدون مياه —</option>
          ${optionsHtml}
        </select>
        <div id="waterPriceNote" style="display:none;background:linear-gradient(135deg,#e8f4fd,#d6eaf8);border:1px solid #aed6f1;border-radius:10px;padding:8px 12px;margin-bottom:10px;font-size:12px;color:#1a6fa8;font-weight:700;display:flex;align-items:center;gap:6px;">
          <i class="fa fa-tint" style="color:#3498db;"></i>
          <span id="waterPriceText"></span>
        </div>`;
    }
    return `<label class="sp-field-label"><i class="fa ${f.icon}" style="color:var(--accent);margin-left:4px;"></i> ${f.label}</label>
      <input class="sp-field-input" id="${f.id}" type="${f.type||'text'}" placeholder="${f.placeholder}"${f.maxlength ? ` maxlength="${f.maxlength}"` : ''}>`;
  }).join('');

  // Packages
  const pkgsEl = document.getElementById('spModalPackages');
  pkgsEl.innerHTML = '';
  document.getElementById('spCustomAmt').value = '';
  if(p.packages){
    p.packages.forEach((pkg, i) => {
      pkgsEl.innerHTML += `
        <div class="sp-pkg-btn" id="sp-amt-${i}" onclick="selectSpAmt(${i},'${pkg.label}','${pkg.price}')">
          <div>${pkg.label}</div>
          <div class="sp-pkg-price">${pkg.price} $</div>
        </div>`;
    });
  }

  // Button color / state based on login
  const buyBtn = document.getElementById('spBtnBuy');
  if (!auth.currentUser) {
    buyBtn.innerHTML = '<i class="fa fa-lock"></i> سجّل دخولك للشراء';
    buyBtn.style.background = 'linear-gradient(135deg,#636e72,#2d3436)';
    buyBtn.onclick = function(){ closeStoreProduct(); showLoginRequired('سجّل دخولك أولاً للتسوق من المتجر'); };
  } else {
    buyBtn.innerHTML = '<i class="fa fa-bolt"></i> شراء الآن';
    buyBtn.style.background = `linear-gradient(135deg,${p.color1||'#1a1a2e'},${p.color2||'#0f3460'})`;
    buyBtn.onclick = doStorePurchase;
  }

  // Admin delete
  document.getElementById('spDeleteWrap').style.display = isAdmin ? 'block' : 'none';

  document.getElementById('storeProductModal').classList.add('open');
}

function closeStoreProduct(){
  document.getElementById('storeProductModal').classList.remove('open');
  currentStoreProduct = null;
  selectedSpAmt = null;
  const btn = document.getElementById('spBtnBuy');
  if(btn) btn.innerHTML = '<i class="fa fa-bolt"></i> شراء الآن';
}

function onWaterSelect(el){
  const opt = el.options[el.selectedIndex];
  const waterPrice = parseFloat(opt.getAttribute('data-price')) || 0;
  const noteDiv  = document.getElementById('waterPriceNote');
  const noteText = document.getElementById('waterPriceText');

  if(waterPrice > 0){
    noteDiv.style.display = 'flex';
    noteText.textContent  = `سيُضاف ${waterPrice.toFixed(3)} $ كسعر كرت المياه على إجمالي الطلب`;
  } else {
    noteDiv.style.display = 'none';
  }

  // إعادة حساب السعر الإجمالي إذا كانت باقة محددة
  recalcTotalWithWater();
}

function recalcTotalWithWater(){
  if(!currentStoreProduct || currentStoreProduct.type !== 'electricity') return;
  if(!selectedSpAmt) return;

  const waterEl    = document.getElementById('sp_elec_water');
  const waterPrice = waterEl
    ? parseFloat(waterEl.options[waterEl.selectedIndex]?.getAttribute('data-price') || 0)
    : 0;

  const basePrice  = parseFloat(selectedSpAmt.price) || 0;
  const total      = (basePrice + waterPrice).toFixed(3);
  document.getElementById('spCustomAmt').value = total;

  // تحديث نص زر الشراء
  const btn = document.getElementById('spBtnBuy');
  if(btn) btn.innerHTML = `<i class="fa fa-bolt"></i> شراء الآن — ${total} $`;
}

function selectSpAmt(idx, label, price){
  document.querySelectorAll('.sp-pkg-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('sp-amt-'+idx).classList.add('active');
  selectedSpAmt = { label, price };

  // احسب مع المياه إذا كهرباء
  if(currentStoreProduct && currentStoreProduct.type === 'electricity'){
    const waterEl    = document.getElementById('sp_elec_water');
    const waterPrice = waterEl
      ? parseFloat(waterEl.options[waterEl.selectedIndex]?.getAttribute('data-price') || 0)
      : 0;
    const total = (parseFloat(price) + waterPrice).toFixed(3);
    document.getElementById('spCustomAmt').value = total;
    const btn = document.getElementById('spBtnBuy');
    if(btn) btn.innerHTML = `<i class="fa fa-bolt"></i> شراء الآن — ${total} $`;
  } else {
    document.getElementById('spCustomAmt').value = price;
    const btn = document.getElementById('spBtnBuy');
    if(btn) btn.innerHTML = `<i class="fa fa-bolt"></i> شراء الآن`;
  }
}

function clearSpSelection(){
  document.querySelectorAll('.sp-pkg-btn').forEach(b => b.classList.remove('active'));
  selectedSpAmt = null;
}

async function doStorePurchase(){
  if(!auth.currentUser){ showLoginRequired('سجّل دخولك للمتابعة'); return; }
  if(!currentStoreProduct) return;

  const buyBtn = document.getElementById('spBtnBuy');
  if(buyBtn.disabled) return;
  buyBtn.disabled = true;
  buyBtn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> جاري الإرسال...';

  const p      = currentStoreProduct;
  const fields = PRODUCT_TYPE_FIELDS[p.type] || [];

  // ===== جمع قيم الحقول =====
  const fieldValues = {};
  for(const f of fields){
    const el  = document.getElementById(f.id);
    const val = el ? el.value.trim() : '';
    if(f.type === 'select_optional'){
      if(val) fieldValues[f.label] = val;
    } else if(f.type === 'water_select'){
      if(val){
        const opt    = el.options[el.selectedIndex];
        const wPrice = parseFloat(opt.getAttribute('data-price')) || 0;
        fieldValues[f.label] = `${val} (${wPrice.toFixed(3)} $)`;
      }
    } else {
      if(!el || !val){
        showToast('يرجى ملء جميع الحقول المطلوبة','warning'); return;
        buyBtn.disabled = false;
        buyBtn.innerHTML = '<i class="fa fa-bolt"></i> شراء الآن';
        return;
      }
      fieldValues[f.label] = val;
    }
  }

  // ===== التحقق من السعر =====
  const priceStr = document.getElementById('spCustomAmt').value.trim();
  const price    = Math.round(parseFloat(priceStr) * 1000) / 1000; // تقريب لـ 3 خانات
  if(!price || price <= 0 || isNaN(price)){
    showToast('يرجى اختيار باقة أو إدخال مبلغ صحيح','warning'); return;
    buyBtn.disabled = false;
    buyBtn.innerHTML = '<i class="fa fa-bolt"></i> شراء الآن';
    return;
  }

  const uid      = auth.currentUser.uid;
  const userRef  = db.collection('users').doc(uid);
  const ordersRef= db.collection('storeOrders');

  try {
    // ===== Transaction آمنة: خصم الرصيد + حفظ الطلب في عملية واحدة أتومية =====
    let newBalance;
    let userData;
    const amtLabel = selectedSpAmt ? selectedSpAmt.label : `${price.toFixed(3)} $`;
    const newOrderRef = ordersRef.doc(); // مرجع الطلب الجديد

    await db.runTransaction(async tx => {
      const userSnap = await tx.get(userRef);
      if(!userSnap.exists) throw new Error('المستخدم غير موجود');

      userData = userSnap.data();
      const currentBal = Math.round(parseFloat(userData.balance || '0') * 1000) / 1000;

      if(isNaN(currentBal)) throw new Error('رصيد غير صالح');
      if(price > currentBal) throw new Error(`رصيدك غير كافٍ — رصيدك: ${currentBal.toFixed(3)} $`);

      newBalance = Math.round((currentBal - price) * 1000) / 1000;
      if(newBalance < 0) throw new Error('خطأ في حساب الرصيد');

      // خصم الرصيد وحفظ الطلب في نفس الـ Transaction
      tx.update(userRef, { balance: newBalance.toFixed(3) });
      tx.set(newOrderRef, {
        userId       : uid,
        userEmail    : auth.currentUser.email,
        userName     : userData.name || auth.currentUser.email,
        topupCode    : userData.topupCode || '—',
        productId    : p.id,
        productName  : p.name,
        productType  : p.type,
        fields       : fieldValues,
        amount       : amtLabel,
        price        : price,
        priceStr     : price.toFixed(3),
        balanceBefore: parseFloat(userData.balance || '0'),
        balanceAfter : newBalance,
        status       : 'pending',
        createdAt    : firebase.firestore.FieldValue.serverTimestamp()
      });
    });

    // تحديث الشريط العلوي
    document.getElementById('topbarBalance').textContent = newBalance.toFixed(3);

    // إعادة تفعيل الزر وإغلاق المودال
    buyBtn.disabled = false;
    buyBtn.innerHTML = '<i class="fa fa-bolt"></i> شراء الآن';
    closeStoreProduct();

    // فتح السلة
    const cartPanel   = document.getElementById('cartPanel');
    const cartOverlay = document.getElementById('cartOverlay');
    cartPanel.classList.add('open');
    cartOverlay.classList.add('open');
    loadUserOrders(uid);

    // رسالة نجاح
    const msg = document.createElement('div');
    msg.style.cssText = 'position:fixed;top:80px;left:50%;transform:translateX(-50%);background:white;border-radius:16px;padding:14px 20px;box-shadow:0 8px 30px rgba(0,0,0,0.15);z-index:9999;display:flex;align-items:center;gap:10px;font-family:Cairo,sans-serif;font-weight:700;font-size:14px;color:var(--primary);animation:dropDown 0.3s ease;max-width:340px;width:calc(100% - 40px);';
    msg.innerHTML = `<i class="fa fa-check-circle" style="color:#00b894;font-size:20px;"></i><div><div>تم إرسال طلبك! ⏳ قيد المراجعة</div><div style="font-size:12px;color:#aaa;font-weight:600;margin-top:2px;">تم خصم ${price.toFixed(3)} $ · رصيدك: ${newBalance.toFixed(3)} $</div></div>`;
    document.body.appendChild(msg);
    setTimeout(() => { if(msg.parentNode) msg.remove(); }, 4000);

  } catch(err){
    showToast(err.message||'حدث خطأ، حاول مرة أخرى','error');
    buyBtn.disabled = false;
    buyBtn.innerHTML = '<i class="fa fa-bolt"></i> شراء الآن';
  }
}

async function deleteStoreProduct(){
  if(!currentStoreProduct) return;
  if(!await showConfirm('حذف المنتج','هل أنت متأكد من حذف هذا المنتج؟','🗑️','حذف')) return;
  await db.collection('storeProducts').doc(currentStoreProduct.id).delete();
