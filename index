// cache بيانات المستخدمين لتجنب طلبات متكررة
const usersCache = {};

async function getAuthorData(uid){
  if(usersCache[uid]) return usersCache[uid];
  try {
    const doc = await db.collection('users').doc(uid).get();
    const data = doc.exists ? doc.data() : null;
    usersCache[uid] = data;
    return data;
  } catch(e){ return null; }
}

