/* ===== notifications panel ===== */
function toggleNotifs(){
  const panel   = document.getElementById('notifsPanel');
  const overlay = document.getElementById('notifsOverlay');
  const isOpen  = panel.classList.contains('open');
  if(isOpen){
    closeNotifs();
  } else {
    panel.classList.add('open');
    overlay.classList.add('open');
    if(auth.currentUser){
      const uid = auth.currentUser.uid;
      const ref = db.collection("users").doc(uid).collection("notifications");
      // mark all as read
      ref.where("read","==",false).get().then(snap => {
        snap.forEach(d => d.ref.update({ read: true }));
      });
      // mark all as shown (لا تظهر popup مرة ثانية)
      ref.where("shown","==",false).get().then(snap => {
        snap.forEach(d => d.ref.update({ shown: true }));
      });
    }
  }
}

/* ===== إظهار إشعارات الطلبات للعضو مرة واحدة فقط ===== */
function showUnseenOrderNotifs(uid){
  db.collection("users").doc(uid).collection("notifications")
    .where("shown","==",false)
    .get().then(snap => {
      if(snap.empty) return;
      // فلتر فقط الموافقة والرفض
      const relevant = [];
      snap.forEach(doc => {
        const n = doc.data();
        if(n.type === 'order_approved' || n.type === 'order_rejected'){
          relevant.push({ id: doc.id, ref: doc.ref, data: n });
        }
      });
      if(relevant.length === 0) return;

      // عرض popup لكل إشعار بتأخير بسيط بينهم
      relevant.forEach((item, idx) => {
        setTimeout(() => {
          showOrderToast(item.data);
          // ضع shown: true حتى لا يظهر مرة ثانية
          item.ref.update({ shown: true });
        }, idx * 1200);
      });
    });
}

function showOrderToast(n){
  const isApproved = n.type === 'order_approved';
  const color  = isApproved ? '#00b894' : '#e94560';
  const icon   = isApproved ? 'fa-check-circle' : 'fa-times-circle';
  const bgGrad = isApproved
    ? 'linear-gradient(135deg,#f0fdf9,#fff)'
    : 'linear-gradient(135deg,#fff5f7,#fff)';

  const toast = document.createElement('div');
  toast.style.cssText = `
    position:fixed; bottom:80px; left:50%; transform:translateX(-50%);
    background:${bgGrad};
    border:2px solid ${color}44;
    border-radius:20px; padding:14px 18px;
    box-shadow:0 8px 32px rgba(0,0,0,0.14);
    z-index:9999; width:calc(100% - 32px); max-width:400px;
    display:flex; align-items:flex-start; gap:12px;
    animation:slideUp 0.35s ease;
    font-family:Cairo,sans-serif;
    cursor:pointer;
  `;
  toast.innerHTML = `
    <div style="width:42px;height:42px;border-radius:50%;background:${color}18;
      border:2px solid ${color}44;display:flex;align-items:center;
      justify-content:center;flex-shrink:0;">
      <i class="fa ${icon}" style="color:${color};font-size:20px;"></i>
    </div>
    <div style="flex:1;min-width:0;">
      <div style="font-weight:900;color:#1a1a2e;font-size:14px;margin-bottom:4px;">${n.title}</div>
      <div style="font-size:12px;color:#666;line-height:1.5;">${n.body}</div>
      ${isApproved ? `<div style="font-size:11px;color:${color};font-weight:700;margin-top:5px;"><i class="fa fa-hand-pointer"></i> اضغط لفتح سلة المشتريات</div>` : ''}
    </div>
    <button onclick="this.parentElement.remove()" style="background:none;border:none;color:#aaa;font-size:18px;cursor:pointer;flex-shrink:0;padding:0;line-height:1;">×</button>
  `;

  // عند الضغط — فتح السلة إذا كان موافقة
  toast.addEventListener('click', (e) => {
    if(e.target.tagName === 'BUTTON') return;
    if(isApproved){ toggleCart(); }
    toast.remove();
  });

  document.body.appendChild(toast);

  // يختفي تلقائياً بعد 6 ثواني
  setTimeout(() => { if(toast.parentNode) toast.remove(); }, 6000);
}
function closeNotifs(){
  document.getElementById('notifsPanel').classList.remove('open');
  document.getElementById('notifsOverlay').classList.remove('open');
}

function loadNotifications(uid){
  if(notifsListener) notifsListener();
  let firstLoad = true;
  notifsListener = db.collection("users").doc(uid).collection("notifications")
    .orderBy("createdAt","desc").limit(30)
    .onSnapshot(snap => {
      const list = document.getElementById("notifsList");
      let unread = 0;

      if(snap.empty){
        list.innerHTML = '<div class="notif-empty"><i class="fa fa-bell-slash"></i>لا توجد إشعارات</div>';
      } else {
        list.innerHTML = "";
        snap.forEach(doc => {
          const n = doc.data();
          if(!n.read) unread++;
          const date = n.createdAt ? n.createdAt.toDate() : new Date();
          const timeStr = date.toLocaleDateString('ar-EG',{year:'numeric',month:'long',day:'numeric'})
            + ' - ' + date.toLocaleTimeString('ar-EG',{hour:'2-digit',minute:'2-digit'});
          const isOrderApproved = n.type === 'order_approved';
          const notifIcon = isOrderApproved ? 'fa-check-circle'
            : n.type === 'order_rejected' ? 'fa-times-circle'
            : n.type === 'order_pending'  ? 'fa-shopping-cart'
            : n.type === 'transfer'       ? 'fa-coins'
            : 'fa-bell';
          list.innerHTML += `
            <div class="notif-item ${n.read?'':'unread'}" ${isOrderApproved ? 'style="cursor:pointer;" onclick="closeNotifs();toggleCart()"' : ''}>
              <div class="notif-title"><i class="fa ${notifIcon}"></i>${n.title}</div>
              <div class="notif-body">${n.body}</div>
              ${isOrderApproved ? '<div style="font-size:11px;color:var(--highlight);font-weight:700;margin-top:4px;"><i class=\"fa fa-hand-pointer\"></i> انقر لفتح سلة المشتريات</div>' : ''}
              <div class="notif-time"><i class="fa fa-clock"></i> ${timeStr}</div>
            </div>`;
        });

        // إظهار toast للإشعارات الجديدة real-time (بعد أول تحميل)
        if(!firstLoad){
          snap.docChanges().forEach(change => {
            if(change.type === 'added'){
              const n = change.doc.data();
              // فقط للعضو غير الأدمن وللأنواع المهمة وإذا لم تُعرض بعد
              if(auth.currentUser && auth.currentUser.email !== ADMIN_EMAIL
                && n.shown === false
                && (n.type==='order_approved' || n.type==='order_rejected' || n.type==='transfer')){
                showOrderToast(n);
                change.doc.ref.update({ shown: true });
              }
            }
          });
        }
      }

      firstLoad = false;
      document.getElementById('bellDot').classList.toggle('active', unread > 0);
    });
}

