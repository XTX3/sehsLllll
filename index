/* ===== تنبيه الأدمن بالطلبات المعلقة ===== */
#adminPendingAlert {
  display: none;
  position: fixed;
  top: 80px; left: 50%; transform: translateX(-50%);
  z-index: 9999;
  background: linear-gradient(135deg, #1a1a2e, #0f3460);
  border: 2px solid #f39c12;
  border-radius: 22px;
  padding: 16px 22px;
  box-shadow: 0 8px 40px rgba(243,156,18,0.35), 0 4px 20px rgba(0,0,0,0.3);
  min-width: 280px; max-width: calc(100% - 40px);
  animation: alertPop 0.4s cubic-bezier(0.175,0.885,0.32,1.275);
  cursor: pointer;
}
@keyframes alertPop {
  0%  { opacity:0; transform: translateX(-50%) scale(0.7) translateY(-20px); }
  100%{ opacity:1; transform: translateX(-50%) scale(1)   translateY(0);     }
}
@keyframes alertShake {
  0%,100%{ transform: translateX(-50%) rotate(0deg); }
  20%    { transform: translateX(-50%) rotate(-2deg); }
  40%    { transform: translateX(-50%) rotate(2deg);  }
  60%    { transform: translateX(-50%) rotate(-2deg); }
  80%    { transform: translateX(-50%) rotate(2deg);  }
}
.admin-alert-inner {
  display: flex; align-items: center; gap: 14px;
}
.admin-alert-bell {
  width: 48px; height: 48px; border-radius: 50%;
