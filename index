.store-tab {
  flex-shrink:0; padding:8px 16px; border-radius:20px;
  border:2px solid #e8e8e8; background:white;
  font-family:'Cairo',sans-serif; font-weight:700; font-size:13px;
  color:#777; cursor:pointer; transition:all 0.2s;
}
.store-tab.active { border-color:var(--highlight); color:var(--highlight); background:#f0fdf9; }

.store-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
.store-card {
  background:white; border-radius:18px; overflow:visible;
  box-shadow:0 2px 14px rgba(0,0,0,0.07);
  cursor:pointer; transition:all 0.25s; border:2px solid transparent;
}
.store-card:hover { transform:translateY(-3px); box-shadow:0 8px 24px rgba(0,0,0,0.12); }
.store-card:active { transform:scale(0.97); }
.store-card-img {
  width:100%; height:100px; object-fit:cover; display:block;
  border-radius:16px 16px 0 0;
}
.store-card-icon {
  width:100%; height:100px;
  display:flex; align-items:center; justify-content:center;
  font-size:36px; color:white;
  border-radius:16px 16px 0 0;
}
.store-card-body { padding:10px 12px 12px; }
.store-card-name { font-weight:900; color:var(--primary); font-size:13px; margin-bottom:2px; }
.store-card-sub  { font-size:11px; color:#aaa; font-weight:600; }
.store-card-type-badge {
  display:inline-block; font-size:10px; font-weight:700; padding:2px 8px;
  border-radius:20px; margin-top:5px;
}

/* ===== نافذة شراء المنتج ===== */
#storeProductModal {
  display:none; position:fixed; inset:0; z-index:9997;
  justify-content:center; align-items:flex-end;
  background:rgba(0,0,0,0.5); backdrop-filter:blur(5px);
}
#storeProductModal.open { display:flex; }
.store-product-box {
  background:white; width:100%; max-width:500px;
  border-radius:24px 24px 0 0; padding:20px 20px 30px;
  animation:slideUp 0.3s ease; max-height:90vh; overflow-y:auto;
}

/* ===== لوحة نشر المنتج (أدمن) ===== */
.store-admin-panel {
  background:white; border-radius:18px; padding:18px;
  margin-bottom:20px; box-shadow:0 4px 20px rgba(0,0,0,0.07);
  border-right:4px solid var(--gold);
}
.store-package-row {
  display:flex; gap:8px; align-items:center; margin-bottom:8px;
}
.store-package-row input {
  flex:1; padding:9px 12px; border-radius:10px;
  border:1.5px solid #e8e8e8; font-family:'Cairo',sans-serif;
  font-size:13px; outline:none;
}
.store-package-row input:focus { border-color:var(--accent); }
.btn-remove-pkg {
  background:#fff0f3; border:none; width:32px; height:32px; border-radius:8px;
  color:#e94560; font-size:14px; cursor:pointer; flex-shrink:0;
  display:flex; align-items:center; justify-content:center;
}
.btn-add-pkg {
  width:100%; padding:9px; border:2px dashed #e8e8e8; border-radius:12px;
  background:transparent; font-family:'Cairo',sans-serif; font-weight:700;
  color:#aaa; cursor:pointer; transition:all 0.2s; font-size:13px; margin-bottom:12px;
}
.btn-add-pkg:hover { border-color:var(--highlight); color:var(--highlight); }

/* ===== نافذة شراء المنتج - ستيل مستقل ===== */
#storeProductModal {
  display:none; position:fixed; inset:0; z-index:9997;
  justify-content:center; align-items:flex-end;
  background:rgba(0,0,0,0.5); backdrop-filter:blur(5px);
}
#storeProductModal.open { display:flex; }
.store-product-box {
  background:white; width:100%; max-width:500px;
  border-radius:24px 24px 0 0; padding:20px 20px 30px;
  animation:slideUp 0.3s ease; max-height:90vh; overflow-y:auto;
}
.sp-header {
  display:flex; align-items:center; gap:12px; margin-bottom:18px;
}
.sp-icon {
  width:48px; height:48px; border-radius:13px;
  display:flex; align-items:center; justify-content:center;
  font-size:22px; color:white; flex-shrink:0;
}
.sp-header h4 { font-weight:900; color:var(--primary); font-size:17px; flex:1; }
.sp-close-btn {
  background:#f5f5f5; border:none; width:34px; height:34px;
  border-radius:50%; font-size:15px; cursor:pointer;
  display:flex; align-items:center; justify-content:center;
  transition:all 0.3s; color:#555;
}
.sp-close-btn:hover { background:#e0e0e0; transform:rotate(90deg); }
.sp-balance-row {
  background:#f8f8f8; border-radius:12px; padding:10px 14px;
  display:flex; justify-content:space-between; align-items:center;
  margin-bottom:14px; font-size:13px;
}
.sp-balance-row span:first-child { color:#888; font-weight:600; }
.sp-balance-row span:last-child  { color:var(--highlight); font-weight:900; font-size:15px; }
.sp-field-label {
  font-size:12px; font-weight:700; color:#888;
  margin-bottom:6px; display:block;
}
.sp-field-input {
  width:100%; padding:12px 16px; border-radius:14px;
  border:2px solid #e8e8e8; font-family:'Cairo',sans-serif;
  font-size:14px; outline:none; margin-bottom:14px; transition:border 0.3s;
  box-sizing:border-box;
}
.sp-field-input:focus { border-color:var(--accent); }
.sp-packages-grid {
  display:grid; grid-template-columns:repeat(3,1fr);
  gap:8px; margin-bottom:16px;
}
.sp-pkg-btn {
  padding:10px 6px; border:2px solid #e8e8e8; border-radius:12px;
  text-align:center; cursor:pointer; font-weight:700; font-size:13px;
  color:#555; transition:all 0.2s; background:white;
  font-family:'Cairo',sans-serif;
}
.sp-pkg-btn:hover  { border-color:var(--highlight); color:var(--highlight); }
.sp-pkg-btn.active { border-color:var(--highlight); color:var(--highlight); background:#f0fdf9; }
.sp-pkg-btn .sp-pkg-price { font-size:11px; color:#aaa; font-weight:600; }
.sp-custom-label {
  font-size:12px; font-weight:700; color:#888;
  margin-bottom:6px; display:block;
}
.sp-custom-input {
  width:100%; padding:12px 16px; border-radius:14px;
  border:2px solid #e8e8e8; font-family:'Cairo',sans-serif;
  font-size:14px; outline:none; margin-bottom:14px; transition:border 0.3s;
  box-sizing:border-box;
}
.sp-custom-input:focus { border-color:var(--accent); }
.sp-buy-btn {
  width:100%; padding:14px; border:none; border-radius:14px;
  color:white; font-weight:900; font-family:'Cairo',sans-serif;
  font-size:16px; cursor:pointer; transition:all 0.3s;
  display:flex; align-items:center; justify-content:center; gap:8px;
}
.sp-buy-btn:hover { opacity:0.9; transform:translateY(-1px); }
.sp-buy-btn:disabled { opacity:0.6; cursor:not-allowed; transform:none; }

/* ===== PHONES SECTION ===== */
.phones-tabs-bar {
  display:flex; gap:0; overflow-x:auto; margin-bottom:14px;
  background:white; border-radius:16px; padding:4px;
  box-shadow:0 2px 12px rgba(0,0,0,0.07);
}
.phones-tabs-bar::-webkit-scrollbar{display:none;}
.ph-tab {
  flex-shrink:0; padding:10px 16px; border-radius:12px;
  font-family:'Cairo',sans-serif; font-weight:700; font-size:13px;
  color:#777; cursor:pointer; transition:all 0.25s; white-space:nowrap;
  border:none; background:transparent;
}
.ph-tab.active { background:var(--primary); color:white; }
.ph-groups-bar { display:flex; gap:8px; overflow-x:auto; padding-bottom:4px; margin-bottom:14px; }
.ph-groups-bar::-webkit-scrollbar{display:none;}
.ph-group-chip {
  flex-shrink:0; padding:7px 16px; border-radius:20px;
  border:2px solid #e0e0e0; background:white;
  font-family:'Cairo',sans-serif; font-weight:700; font-size:12px;
  color:#666; cursor:pointer; transition:all 0.2s; white-space:nowrap;
}
.ph-group-chip.active { border-color:var(--highlight); color:var(--highlight); background:#f0fdf9; }
.ph-group-chip.admin-add { border-style:dashed; border-color:#ccc; color:#aaa; display:flex; align-items:center; gap:5px; }
.ph-group-chip.admin-add:hover { border-color:var(--accent); color:var(--accent); }
.ph-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
.ph-card {
  background:white; border-radius:18px; overflow:hidden;
  box-shadow:0 2px 14px rgba(0,0,0,0.07);
  cursor:pointer; transition:all 0.25s;
}
.ph-card:hover { transform:translateY(-3px); box-shadow:0 8px 24px rgba(0,0,0,0.12); }
.ph-card-slider { position:relative; width:100%; height:130px; overflow:hidden; background:#f0f0f0; }
.ph-card-slider img { width:100%; height:130px; object-fit:cover; display:block; position:absolute; top:0; left:0; opacity:0; transition:opacity 0.4s; }
.ph-card-slider img.active { opacity:1; }
.ph-slider-dots { position:absolute; bottom:6px; left:50%; transform:translateX(-50%); display:flex; gap:4px; }
.ph-slider-dot { width:5px; height:5px; border-radius:50%; background:rgba(255,255,255,0.5); transition:all 0.3s; }
.ph-slider-dot.active { background:white; width:12px; border-radius:3px; }
.ph-condition-badge { position:absolute; top:8px; right:8px; padding:3px 9px; border-radius:20px; font-size:10px; font-weight:700; font-family:'Cairo',sans-serif; }
.ph-condition-badge.new { background:#00d4aa; color:white; }
.ph-condition-badge.used { background:#f39c12; color:white; }
.ph-card-body { padding:10px 12px 12px; }
.ph-card-name { font-weight:900; color:var(--primary); font-size:13px; margin-bottom:3px; }
.ph-card-price { font-weight:900; color:var(--gold); font-size:14px; }
.ph-card-group { font-size:10px; color:#aaa; font-weight:600; margin-top:2px; }
#phoneDetailModal { display:none; position:fixed; inset:0; z-index:9997; justify-content:center; align-items:flex-end; background:rgba(0,0,0,0.55); backdrop-filter:blur(5px); }
#phoneDetailModal.open { display:flex; }
.ph-detail-box { background:white; width:100%; max-width:520px; border-radius:24px 24px 0 0; max-height:92vh; overflow-y:auto; animation:slideUp 0.3s ease; }
.ph-detail-slider { position:relative; width:100%; height:260px; overflow:hidden; background:#f0f0f0; flex-shrink:0; }
.ph-detail-slider img { width:100%; height:260px; object-fit:cover; display:block; position:absolute; top:0; left:0; opacity:0; transition:opacity 0.4s; }
.ph-detail-slider img.active { opacity:1; }
.ph-detail-dots { position:absolute; bottom:10px; left:50%; transform:translateX(-50%); display:flex; gap:6px; }
.ph-detail-dot { width:7px; height:7px; border-radius:50%; background:rgba(255,255,255,0.5); cursor:pointer; transition:all 0.3s; border:1px solid rgba(255,255,255,0.4); }
.ph-detail-dot.active { background:white; width:18px; border-radius:4px; }
.ph-detail-nav { position:absolute; top:50%; transform:translateY(-50%); background:rgba(0,0,0,0.35); border:none; color:white; width:36px; height:36px; border-radius:50%; font-size:14px; cursor:pointer; display:flex; align-items:center; justify-content:center; backdrop-filter:blur(4px); transition:all 0.2s; z-index:3; }
