let depCurrency   = 'usd';
let depMethod     = 'shamcash';
let depSyRate     = 11500; // سعر الصرف الافتراضي (الأدمن يغيره)
let depAdminCode  = '';    // كود شام كاش للأدمن

// تحميل إعدادات الإيداع من Firestore
async function loadDepositSettings() {
  try {
    const doc = await db.collection('settings').doc('deposit').get();
    if (doc.exists) {
      const d = doc.data();
      depSyRate    = d.syRate    || 11500;
      depAdminCode = d.shamcashCode || '';
    }
    const codeEl = document.getElementById('depShamcashCode');
    if (codeEl) codeEl.textContent = depAdminCode || 'لم يُحدد بعد';
    // تحديث عرض السعر إذا كانت النافذة مفتوحة
    const rateDisp = document.getElementById('depRateDisplay');
    if (rateDisp) rateDisp.textContent = (depSyRate||11500).toLocaleString() + ' ل.س = 1$';
    const rateInput = document.getElementById('depNewRate');
    if (rateInput) rateInput.value = depSyRate || 11500;
