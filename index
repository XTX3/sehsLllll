function likePost(id){
  if(!requireLogin()) return;
  const uid = auth.currentUser.uid;
  const likeRef = db.collection("posts").doc(id).collection("likes").doc(uid);

  likeRef.get().then(d => {
    if(!d.exists){
      // add like
      likeRef.set({ liked: true, uid: uid, createdAt: firebase.firestore.FieldValue.serverTimestamp() })
        .then(() => {
          // update count using transaction to avoid permission issues
          db.runTransaction(tx => {
            const postRef = db.collection("posts").doc(id);
            return tx.get(postRef).then(postDoc => {
              const newCount = (postDoc.data().likesCount || 0) + 1;
              tx.update(postRef, { likesCount: newCount });
            });
          }).catch(()=>{
            // if transaction fails (permissions), just update the UI anyway
          });
          const btn = document.getElementById("like-"+id);
          if(btn){
            btn.classList.add('liked');
            btn.querySelector('i').className = 'fa-solid fa-heart';
            const countEl = document.getElementById('likeCount-'+id);
            if(countEl) countEl.textContent = parseInt(countEl.textContent||0) + 1;
          }
        })
        .catch(err => {
          console.error('like error:', err);
          showLoginRequired('سجّل دخولك للإعجاب بالمنشورات');
        });
    } else {
      // unlike
      likeRef.delete().then(() => {
        db.runTransaction(tx => {
          const postRef = db.collection("posts").doc(id);
          return tx.get(postRef).then(postDoc => {
            const newCount = Math.max(0, (postDoc.data().likesCount || 1) - 1);
            tx.update(postRef, { likesCount: newCount });
          });
        }).catch(()=>{});
        const btn = document.getElementById("like-"+id);
        if(btn){
          btn.classList.remove('liked');
          btn.querySelector('i').className = 'fa-regular fa-heart';
          const countEl = document.getElementById('likeCount-'+id);
          if(countEl) countEl.textContent = Math.max(0, parseInt(countEl.textContent||1) - 1);
        }
      });
    }
  }).catch(err => {
    console.error('like get error:', err.code, err.message);
    if(!auth.currentUser) showLoginRequired('سجّل دخولك للإعجاب بالمنشورات');
  });
}

function checkIfLiked(id){
  if(!auth.currentUser) return;
  db.collection("posts").doc(id).collection("likes").doc(auth.currentUser.uid).get()
    .then(doc => {
      if(doc.exists){
        const btn = document.getElementById("like-"+id);
        if(btn){ btn.classList.add('liked'); btn.querySelector('i').className = 'fa-solid fa-heart'; }
      }
    }).catch(()=>{});
}
