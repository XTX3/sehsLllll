function login(){
  // check lockout
  const lockoutUntil = parseInt(localStorage.getItem('loginLockout')||'0');
  if(Date.now() < lockoutUntil){ startLockoutTimer(lockoutUntil); return; }

  const email = document.getElementById("loginEmail").value.trim();
  const pass  = document.getElementById("loginPass").value;
  const errEl = document.getElementById("loginError");
  errEl.style.display = 'none';

  if(!email){ showLoginError("يرجى إدخال البريد الإلكتروني"); return; }
  if(!pass)  { showLoginError("يرجى إدخال كلمة المرور"); return; }

  auth.signInWithEmailAndPassword(email, pass)
    .then(()=>{
      // save credentials if remember me
      if(document.getElementById('rememberMe')?.checked){
        localStorage.setItem('savedCredentials', JSON.stringify({email, pass}));
      } else {
        localStorage.removeItem('savedCredentials');
      }
      localStorage.removeItem('loginAttempts');
      localStorage.removeItem('loginLockout');
    })
    .catch(err => {
      // count failed attempts
      let attempts = parseInt(localStorage.getItem('loginAttempts')||'0') + 1;
      localStorage.setItem('loginAttempts', attempts);
      if(attempts >= 5){
        const lockUntil = Date.now() + 5 * 60 * 1000;
        localStorage.setItem('loginLockout', lockUntil);
        localStorage.setItem('loginAttempts','0');
        startLockoutTimer(lockUntil);
        return;
      }
      showLoginError(translateAuthError(err.code));
    });
}

function showLoginError(msg){
  const el = document.getElementById('loginError');
  if(el){ el.textContent = '⚠️ ' + msg; el.style.display = 'block'; }
}

function startLockoutTimer(until){
  const lockEl   = document.getElementById('loginLockout');
  const timerEl  = document.getElementById('lockoutTimer');
  const loginBtn = document.getElementById('loginBtn');
  if(!lockEl) return;
  lockEl.style.display = 'block';
  if(loginBtn) loginBtn.disabled = true;
  const iv = setInterval(()=>{
    const left = Math.max(0, until - Date.now());
    const m = Math.floor(left/60000);
    const s = Math.floor((left%60000)/1000);
    if(timerEl) timerEl.textContent = String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');
    if(left <= 0){
      clearInterval(iv);
      localStorage.removeItem('loginLockout');
      if(lockEl) lockEl.style.display = 'none';
      if(loginBtn){ loginBtn.disabled = false; }
    }
  }, 1000);
}

