/* ===== فتح تفاصيل الجهاز ===== */
function openPhoneDetail(productId) {
  const p = phProducts.find(x => x.id === productId);
  if (!p) return;
  currentPhoneProduct = p;
  phDetailImgIndex = 0;
  phWaNumber = p.whatsapp || '';

  const isAdmin = auth.currentUser && auth.currentUser.email === ADMIN_EMAIL;

  // صور
  const slider = document.getElementById('phDetailSlider');
  const imgs = p.images || ['https://via.placeholder.com/400x260?text=لا+توجد+صورة'];

  // إزالة الصور القديمة (مع الإبقاء على الأزرار)
  slider.querySelectorAll('img').forEach(i => i.remove());
  imgs.forEach((src, i) => {
    const img = document.createElement('img');
    img.src = src;
    img.className = i === 0 ? 'active' : '';
    img.onerror = function(){ this.style.display='none'; };
    slider.insertBefore(img, slider.querySelector('.ph-detail-close'));
  });

  // نقاط التنقل
  const dotsEl = document.getElementById('phDetailDots');
  dotsEl.innerHTML = imgs.map((_,i) => `<div class="ph-detail-dot${i===0?' active':''}" onclick="phDetailNavTo(${i})"></div>`).join('');
  dotsEl.style.display = imgs.length > 1 ? 'flex' : 'none';

  // الأزرار السابق/التالي
  slider.querySelectorAll('.ph-detail-nav').forEach(b => b.style.display = imgs.length > 1 ? 'flex' : 'none');

  // معلومات
  document.getElementById('phDetailName').textContent = p.name || '—';
  document.getElementById('phDetailPrice').textContent = p.price ? Number(p.price).toLocaleString('ar') + ' $' : '—';

  // بادجات
  const allGroups = [...(phGroups.new||[]), ...(phGroups.used||[]), ...(phGroups.accessories||[])];
  const grp = allGroups.find(g => g.id === p.groupId);
  let badgesHtml = '';
  if (grp) badgesHtml += `<span class="ph-detail-badge" style="background:#e8f4fd;color:#1a6fa8;">${grp.name}</span>`;
  if (p.category === 'new') badgesHtml += `<span class="ph-detail-badge" style="background:#f0fdf9;color:#00b894;">جديد ✨</span>`;
  if (p.category === 'used') badgesHtml += `<span class="ph-detail-badge" style="background:#fff8e1;color:#d68910;">مستعمل</span>`;
  if (p.category === 'accessories') badgesHtml += `<span class="ph-detail-badge" style="background:#f3e8ff;color:#8e44ad;">اكسسوار</span>`;
  document.getElementById('phDetailBadges').innerHTML = badgesHtml;

  // مواصفات
  const specs = [];
  if (p.ram)       specs.push({ lbl:'RAM', val: p.ram });
  if (p.storage)   specs.push({ lbl:'التخزين', val: p.storage });
  if (p.screen)    specs.push({ lbl:'الشاشة', val: p.screen });
  if (p.battery)   specs.push({ lbl:'البطارية', val: p.battery });
  if (p.camera)    specs.push({ lbl:'الكاميرا', val: p.camera });
  if (p.processor) specs.push({ lbl:'المعالج', val: p.processor });
  const specsEl = document.getElementById('phDetailSpecs');
  specsEl.innerHTML = specs.map(s => `<div class="ph-spec-box"><div class="ph-spec-lbl">${s.lbl}</div><div class="ph-spec-val">${s.val}</div></div>`).join('');

  // وصف
  const descEl = document.getElementById('phDetailDesc');
  if (p.description) { descEl.textContent = p.description; descEl.style.display = 'block'; }
  else { descEl.style.display = 'none'; }

  // أدمن
  document.getElementById('phDetailDelBtn').style.display = isAdmin ? 'flex' : 'none';

  document.getElementById('phoneDetailModal').classList.add('open');
}

