        if (!badge) return;
        let c = 0;
        snap.forEach(doc => { if ((doc.data().unreadByUser||0) > 0) c++; });
        badge.textContent = c > 99 ? '99+' : c;
        badge.style.display = c > 0 ? 'inline-flex' : 'none';
      }, err => {
        console.warn('my tickets badge error:', err.message);
      });
  }
}

