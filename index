    msg.textContent  = 'لا يوجد اتصال بالإنترنت';
    sub.textContent  = 'يرجى توصيل الشبكة للمتابعة';
    banner.classList.add('offline');

  } else if (type === 'slow') {
    icon.textContent = '🐢';
    msg.textContent  = 'الاتصال بطيء';
    sub.textContent  = 'قد يستغرق تحميل البيانات وقتاً أطول';
    banner.classList.add('slow');
    netBannerTimer = setTimeout(() => hideNetBanner(), 5000);

  } else if (type === 'back') {
    icon.textContent = '✅';
    msg.textContent  = 'عاد الاتصال بالإنترنت';
    sub.textContent  = '';
    banner.classList.add('back');
    netBannerTimer = setTimeout(() => hideNetBanner(), 3000);
  }
}

function hideNetBanner() {
  const banner = document.getElementById('netBanner');
  if (banner) { banner.style.animation = 'slideDown 0.3s ease reverse'; setTimeout(() => { banner.className = ''; banner.style.animation = ''; }, 280); }
}

// كشف انقطاع الإنترنت
window.addEventListener('offline', () => {
  wasOffline = true;
  showNetBanner('offline');
});

window.addEventListener('online', () => {
  if (wasOffline) {
    wasOffline = false;
    showNetBanner('back');
  }
});

// كشف الإنترنت البطيء عند التحميل
async function checkConnectionSpeed() {
  if (!navigator.onLine) { showNetBanner('offline'); wasOffline = true; return; }
  try {
    const start = Date.now();
    await fetch('https://www.gstatic.com/generate_204', { cache: 'no-store', mode: 'no-cors', signal: AbortSignal.timeout(4000) });
    const ms = Date.now() - start;
    if (ms > 2000) showNetBanner('slow');
  } catch(e) {
    // إذا انقطع الإنترنت أثناء الكشف
    if (!navigator.onLine) { showNetBanner('offline'); wasOffline = true; }
  }
}

// فحص عند الدخول بعد ثانيتين
setTimeout(checkConnectionSpeed, 2000);

