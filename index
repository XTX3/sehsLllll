/* --- تحميل طلبات المستخدم في السلة (realtime) --- */
function loadUserOrders(uid){
  if(cartOrdersListener) cartOrdersListener();

  const list = document.getElementById('cartList');
  if(list) list.innerHTML = '<div class="notif-empty"><i class="fa fa-spinner fa-spin" style="font-size:28px;color:var(--highlight);"></i><br>جاري التحميل...</div>';

  cartOrdersListener = db.collection('storeOrders')
    .where('userId','==',uid)
    .onSnapshot(snap => {
      const list = document.getElementById('cartList');
      if(!list) return;

      if(snap.empty){
        list.innerHTML = '<div class="notif-empty"><i class="fa fa-shopping-cart"></i><br>لا توجد طلبات</div>';
        const dot = document.getElementById('cartDot');
        if(dot){ dot.classList.remove('active'); }
        return;
      }

      // ترتيب من الأحدث للأقدم (client-side)
      const docs = [];
      snap.forEach(doc => docs.push({ id: doc.id, ...doc.data() }));
      docs.sort((a,b) => {
        const ta = a.createdAt ? a.createdAt.toMillis() : 0;
        const tb = b.createdAt ? b.createdAt.toMillis() : 0;
        return tb - ta;
      });

      const statusMap = {
        pending:  { cls:'pending',  icon:'⏳', label:'قيد المراجعة' },
        approved: { cls:'approved', icon:'✅', label:'تمت الموافقة' },
        rejected: { cls:'rejected', icon:'❌', label:'مرفوض' }
      };

      const TYPE_ICONS  = { game:'fa-gamepad', voice:'fa-microphone', balance:'fa-credit-card', followers:'fa-users', electricity:'fa-bolt' };
      const TYPE_COLORS_LOCAL = { game:'#f39c12', voice:'#9b59b6', balance:'#27ae60', followers:'#e94560', electricity:'#e6b800' };

      let pendingCount = 0;
      let cardsHtml = '';

      docs.forEach(o => {
        if(o.status === 'pending') pendingCount++;
        const date = o.createdAt ? o.createdAt.toDate() : new Date();
        const timeStr = date.toLocaleDateString('ar-EG',{day:'numeric',month:'long',year:'numeric'})
          + ' · ' + date.toLocaleTimeString('ar-EG',{hour:'2-digit',minute:'2-digit'});
        const st  = statusMap[o.status] || statusMap.pending;
        const tc  = TYPE_COLORS_LOCAL[o.productType] || '#1a1a2e';
        const ico = TYPE_ICONS[o.productType]  || 'fa-store';

        // حقول المنتج
        let fieldsHtml = '';
        if(o.fields && Object.keys(o.fields).length){
          Object.entries(o.fields).forEach(([k,v]) => {
            fieldsHtml += `
              <div class="uoc-field">
                <span class="uoc-field-lbl">${k}</span>
                <span class="uoc-field-val">${v}</span>
              </div>`;
          });
        }

        const rejectHtml = o.status==='rejected' && o.rejectReason
          ? `<div class="uoc-reject"><i class="fa fa-exclamation-circle"></i> ${o.rejectReason}</div>` : '';

        // صورة كرت الكهرباء (تظهر فقط بعد الموافقة)
        const cardImageHtml = (o.status === 'approved' && o.cardImage) ? `
          <div style="margin:10px 0;border-radius:14px;overflow:hidden;border:2px solid rgba(0,212,170,0.25);background:#f0fdf9;">
            <div style="padding:8px 12px;background:linear-gradient(135deg,#00d4aa22,#00b89411);
              display:flex;align-items:center;gap:6px;border-bottom:1px solid rgba(0,212,170,0.2);">
              <i class="fa fa-image" style="color:var(--highlight);font-size:14px;"></i>
              <span style="font-size:12px;font-weight:700;color:var(--highlight);">⚡ صورة كرت الكهرباء</span>
            </div>
            <img src="${o.cardImage}"
              style="width:100%;display:block;max-height:220px;object-fit:contain;background:#f8f9fa;padding:8px;box-sizing:border-box;"
              onerror="this.style.display='none'">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-top:1px solid rgba(0,212,170,0.2);">
              <a href="${o.cardImage}" target="_blank"
                style="display:flex;align-items:center;justify-content:center;gap:5px;padding:10px;
                color:var(--highlight);font-family:Cairo,sans-serif;font-weight:700;font-size:12px;
                text-decoration:none;border-left:1px solid rgba(0,212,170,0.2);">
                <i class="fa fa-external-link-alt"></i> فتح
              </a>
              <a href="${o.cardImage}" download="electricity-card.jpg" target="_blank"
                style="display:flex;align-items:center;justify-content:center;gap:5px;padding:10px;
                color:var(--primary);font-family:Cairo,sans-serif;font-weight:700;font-size:12px;
                text-decoration:none;">
                <i class="fa fa-download"></i> تنزيل
              </a>
            </div>
          </div>` : '';

        cardsHtml += `
          <div class="uoc-card ${st.cls}">
            <div class="uoc-top">
              <div class="uoc-icon" style="background:linear-gradient(135deg,${tc},${tc}bb);">
                <i class="fa ${ico}"></i>
              </div>
              <div class="uoc-info">
                <div class="uoc-name">${o.productName || '—'}</div>
                <div class="uoc-status ${st.cls}">${st.icon} ${st.label}</div>
              </div>
            </div>
            <div class="uoc-divider"></div>
            <div class="uoc-row">
              <div class="uoc-box">
                <div class="uoc-box-lbl">الباقة</div>
                <div class="uoc-box-val">${o.amount || '—'}</div>
              </div>
              <div class="uoc-box">
                <div class="uoc-box-lbl">السعر المدفوع</div>
                <div class="uoc-box-val" style="color:var(--gold);">${o.price ? o.price.toFixed(3)+' $' : '—'}</div>
              </div>
              <div class="uoc-box">
                <div class="uoc-box-lbl">الرصيد المتبقي</div>
                <div class="uoc-box-val" style="color:var(--highlight);">${o.pricePaid ? o.pricePaid+' $' : '—'}</div>
              </div>
            </div>
            ${fieldsHtml ? `<div class="uoc-fields">${fieldsHtml}</div>` : ''}
            ${cardImageHtml}
            ${rejectHtml}
            <div class="uoc-time"><i class="fa fa-clock"></i> ${timeStr}</div>
          </div>`;
      });

      list.innerHTML = `<div class="uoc-grid">${cardsHtml}</div>`;

      const dot = document.getElementById('cartDot');
      if(dot){
        dot.classList.toggle('active', pendingCount > 0);
        dot.style.background = pendingCount > 0 ? '#f39c12' : '#00d4aa';
      }
    }, err => {
      console.error('cart error:', err);
      const list = document.getElementById('cartList');
      if(list) list.innerHTML = '<div class="notif-empty"><i class="fa fa-exclamation-triangle" style="color:#e94560;"></i><br>حدث خطأ في التحميل</div>';
    });
}

