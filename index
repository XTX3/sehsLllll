  document.getElementById("modalImage").src = image;
  document.getElementById("commentsModal").style.display = "flex";
  loadModalComments(postId);
}
function closeComments(){ document.getElementById("commentsModal").style.display = "none"; }
async function sendComment(){
  if(!requireLogin()) return;
  const restricted = await checkUserRestriction();
  if(restricted) return;
  const text = document.getElementById("modalCommentInput").value.trim();
  if(!text) return;
  db.collection("posts").doc(currentPostId).collection("comments").add({
    text, userEmail: auth.currentUser.email, userId: auth.currentUser.uid,
    createdAt: firebase.firestore.FieldValue.serverTimestamp()
  }).then(() => {
    // تحديث العداد في المنشور
    db.collection("posts").doc(currentPostId).update({
      commentsCount: firebase.firestore.FieldValue.increment(1)
    }).catch(()=>{});
  });
  document.getElementById("modalCommentInput").value = "";
}
function loadModalComments(postId){
  const div = document.getElementById("modalCommentsList");
  db.collection("posts").doc(postId).collection("comments").orderBy("createdAt").onSnapshot(snapshot => {
    div.innerHTML = "";
