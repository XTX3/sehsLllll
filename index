function showToast(msg, type='info', sub='', duration=3500) {
  const container = document.getElementById('toastContainer');
  if (!container) return;
  const icons = { success:'✅', error:'❌', warning:'⚠️', info:'ℹ️' };
  const div = document.createElement('div');
  div.className = 'toast-msg ' + type;
  div.innerHTML = `<span class="t-icon">${icons[type]||'ℹ️'}</span>
    <div class="t-text">${msg}${sub ? `<div class="t-sub">${sub}</div>` : ''}</div>`;
  container.appendChild(div);
  setTimeout(() => {
    div.classList.add('hiding');
    setTimeout(() => div.remove(), 300);
  }, duration);
}

let _confirmResolve = null;
function showConfirm(title, msg, icon='⚠️', yesLabel='تأكيد', isGreen=false) {
  return new Promise(resolve => {
    document.getElementById('confirmTitle').textContent = title;
    document.getElementById('confirmMsg').textContent   = msg;
    document.getElementById('confirmIcon').textContent  = icon;
    document.getElementById('confirmYesBtn').textContent = yesLabel;
    document.getElementById('confirmYesBtn').className = 'confirm-btn-yes' + (isGreen ? ' green' : '');
    document.getElementById('confirmOverlay').classList.add('open');
    document.getElementById('confirmOverlay').style.display = 'flex';
    _confirmResolve = (val) => {
      document.getElementById('confirmOverlay').classList.remove('open');
      document.getElementById('confirmOverlay').style.display = 'none';
      resolve(val);
    };
  });
}

