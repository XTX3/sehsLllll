function generateCode(){
  const c = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
  let code = "";
  for(let i=0;i<8;i++) code += c.charAt(Math.floor(Math.random()*c.length));
  return code;
}

