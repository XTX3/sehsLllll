async function approveOrder(orderId, userId, price, productName, amount, productType){
  // للكهرباء: تحقق من رابط الصورة أولاً
  const isElec = productType === 'electricity';
  let cardImage = '';
  if (isElec) {
    const imgEl = document.getElementById('elec-img-' + orderId);
    cardImage = imgEl ? imgEl.value.trim() : '';
    if (!cardImage) {
      showToast('يرجى إدخال رابط صورة كرت الكهرباء قبل الموافقة','warning'); return;
      if (imgEl) { imgEl.focus(); imgEl.style.borderColor = '#e94560'; }
      return;
    }
  }

  if(!await showConfirm('تأكيد الموافقة','هل تريد الموافقة على هذا الطلب؟','✅','موافقة',true)) return;

  const orderRef = db.collection('storeOrders').doc(orderId);

  try {
    const updateData = {
      status    : 'approved',
      approvedAt: firebase.firestore.FieldValue.serverTimestamp()
    };
    if (cardImage) updateData.cardImage = cardImage;

    await db.runTransaction(async tx => {
      const orderSnap = await tx.get(orderRef);
      if(!orderSnap.exists) throw new Error('الطلب غير موجود');
      if(orderSnap.data().status !== 'pending'){
        throw new Error('هذا الطلب لم يعد معلقاً — لا يمكن تكرار الموافقة');
      }
      tx.update(orderRef, updateData);
    });

    // إشعار للمستخدم
    const notifBody = isElec
      ? `تمت الموافقة على طلب الكهرباء (${amount}). افتح سلة المشتريات 🛒 لتحميل صورة الكرت.`
      : `تمت الموافقة على طلبك لـ ${productName} (${amount}). افتح سلة المشتريات 🛒 لمشاهدة تفاصيل طلبك.`;

    await db.collection('users').doc(userId).collection('notifications').add({
      title    : '✅ تمت الموافقة على طلبك',
      body     : notifBody,
      cardImage: cardImage || null,
      read     : false,
      shown    : false,
      createdAt: firebase.firestore.FieldValue.serverTimestamp(),
      type     : 'order_approved',
      openCart : true
    });

  } catch(err){ showToast(err.message,'error'); }
}

async function rejectOrder(orderId, userId, price, productName){
  const reasonEl = document.getElementById('rjt-'+orderId);
  const reason   = reasonEl ? reasonEl.value.trim() : '';
  if(!reason){ showToast('يرجى كتابة سبب الرفض','warning'); return; return; }
  if(!await showConfirm('تأكيد الرفض','سيتم رفض الطلب وإعادة المبلغ للعضو','❌','رفض وإعادة')) return;

  const orderRef = db.collection('storeOrders').doc(orderId);
  const userRef  = db.collection('users').doc(userId);

  try {
    let restoredBalance;

    await db.runTransaction(async tx => {
      const orderSnap = await tx.get(orderRef);
      const userSnap  = await tx.get(userRef);

      if(!orderSnap.exists) throw new Error('الطلب غير موجود');
      if(!userSnap.exists)  throw new Error('المستخدم غير موجود');

      const orderData = orderSnap.data();

      // منع الرفض المزدوج
      if(orderData.status !== 'pending'){
        throw new Error('هذا الطلب لم يعد معلقاً — لا يمكن رفضه');
      }

      // السعر المحفوظ في الطلب هو المصدر الحقيقي (وليس المُمرَّر)
      const truePrice    = Math.round(parseFloat(orderData.price || price) * 1000) / 1000;
      const currentBal   = Math.round(parseFloat(userSnap.data().balance || '0') * 1000) / 1000;
      restoredBalance    = Math.round((currentBal + truePrice) * 1000) / 1000;

      if(isNaN(restoredBalance)) throw new Error('خطأ في حساب الرصيد');

      // تحديث الطلب + الرصيد في عملية واحدة
      tx.update(orderRef, {
        status      : 'rejected',
        rejectReason: reason,
        rejectedAt  : firebase.firestore.FieldValue.serverTimestamp()
      });
      tx.update(userRef, { balance: restoredBalance.toFixed(3) });
    });

    // إشعار للمستخدم بعد نجاح التحديث
    await db.collection('users').doc(userId).collection('notifications').add({
      title  : '❌ تم رفض طلبك',
      body   : `تم رفض طلبك لـ ${productName}. السبب: ${reason}. تم إعادة ${truePrice.toFixed(3)} $ إلى رصيدك. رصيدك الجديد: ${restoredBalance.toFixed(3)} $`,
      read   : false,
      shown  : false,
      createdAt: firebase.firestore.FieldValue.serverTimestamp(),
      type   : 'order_rejected'
    });

  } catch(err){ showToast(err.message,'error'); }
}

/* ===== تنبيه الأدمن بالطلبات المعلقة كل 30 ثانية ===== */
let adminAlertInterval = null;
let adminPendingCount  = 0;

function startAdminPendingAlert(){
  // للأدمن والمشرف
  if(!auth.currentUser) return;
  if(currentUserRole !== 'admin' && currentUserRole !== 'moderator') return;

  // مراقبة الطلبات المعلقة بشكل real-time
  db.collection('storeOrders').where('status','==','pending')
    .onSnapshot(snap => {
      adminPendingCount = snap.size;
      updatePendingBadge(adminPendingCount);
    });

  // تنبيه كل 30 ثانية فقط للأدمن إذا في طلبات معلقة
  if(adminAlertInterval) clearInterval(adminAlertInterval);
  adminAlertInterval = setInterval(() => {
    if(!auth.currentUser || (currentUserRole !== 'admin' && currentUserRole !== 'moderator')){
      clearInterval(adminAlertInterval);
      return;
    }
    if(adminPendingCount > 0){
      showAdminAlert(adminPendingCount);
    }
  }, 30000);

  // تنبيه فوري عند أول دخول إذا في طلبات
  setTimeout(() => {
    if(auth.currentUser && isAdminOrMod() && adminPendingCount > 0){
      showAdminAlert(adminPendingCount);
    }
  }, 2000);
}

function showAdminAlert(count){
  const el = document.getElementById('adminPendingAlert');
  const countEl = document.getElementById('adminAlertCount');
  if(!el) return;
  countEl.textContent = count;

  // إعادة تشغيل الأنيميشن
  el.style.display = 'none';
  void el.offsetWidth; // reflow
  el.style.display = 'block';

  // شغّل الصوت
  playAlertSound();

  // أخفِ تلقائياً بعد 8 ثواني
  clearTimeout(el._hideTimer);
  el._hideTimer = setTimeout(() => hideAdminAlert(), 8000);
}

function hideAdminAlert(){
  const el = document.getElementById('adminPendingAlert');
  if(el) el.style.display = 'none';
}

function playAlertSound(){
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();

    // نغمة تنبيه مكونة من 3 نبضات
    const notes = [880, 1100, 880];
    let time = ctx.currentTime;

    notes.forEach((freq, i) => {
      const osc  = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.connect(gain);
      gain.connect(ctx.destination);

      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, time);

      gain.gain.setValueAtTime(0, time);
      gain.gain.linearRampToValueAtTime(0.4, time + 0.05);
      gain.gain.exponentialRampToValueAtTime(0.001, time + 0.3);

      osc.start(time);
      osc.stop(time + 0.3);
      time += 0.2;
    });
  } catch(e){ /* المتصفح لا يدعم AudioContext */ }
}




/* ===================================================
   متجر الهواتف - JavaScript كامل
   =================================================== */

let phCurrentTab = 'new';
let phCurrentGroup = 'all';
let phProducts = [];
let phGroups = { new:[], used:[], accessories:[] };
let currentPhoneProduct = null;
let phDetailImgIndex = 0;
let phAddImages = [];
let phWaNumber = '';

/* ===== تهيئة عند فتح القسم ===== */
function initPhonesSection() {
  const isAdmin = auth.currentUser && auth.currentUser.email === ADMIN_EMAIL;
  const adminBar = document.getElementById('phonesAdminBar');
  if (adminBar) adminBar.style.display = isAdmin ? 'block' : 'none';
  loadPhGroups();
  loadPhProducts();
}

/* ===== تحميل المجموعات من Firestore ===== */
function loadPhGroups() {
  db.collection('phoneGroups').orderBy('createdAt').onSnapshot(snap => {
    phGroups = { new:[], used:[], accessories:[] };
    snap.forEach(doc => {
      const d = doc.data();
      if (phGroups[d.category]) phGroups[d.category].push({ id:doc.id, name:d.name });
    });
    renderPhGroups();
    updatePhGroupSelect();
  });
}

/* ===== رسم شريط المجموعات ===== */
function renderPhGroups() {
  const bar = document.getElementById('phGroupsBar');
  if (!bar) return;
  if (phCurrentTab === 'winners') { bar.innerHTML = ''; return; }

  const groups = phGroups[phCurrentTab] || [];
  const isAdmin = auth.currentUser && auth.currentUser.email === ADMIN_EMAIL;
  let html = `<div class="ph-group-chip active" onclick="selectPhGroup('all',this)">الكل</div>`;
  groups.forEach(g => {
    html += `<div class="ph-group-chip" onclick="selectPhGroup('${g.id}',this)">${g.name}</div>`;
  });
  if (isAdmin) {
    html += `<div class="ph-group-chip admin-add" onclick="openAddGroupModal()"><i class="fa fa-plus"></i> مجموعة</div>`;
  }
  bar.innerHTML = html;
  phCurrentGroup = 'all';
}

/* ===== تحميل المنتجات ===== */
function loadPhProducts() {
  db.collection('phoneProducts').orderBy('createdAt','desc').onSnapshot(snap => {
    phProducts = [];
    snap.forEach(doc => phProducts.push({ id:doc.id, ...doc.data() }));
    renderPhGrid();
  });
}

/* ===== رسم شبكة المنتجات ===== */
function renderPhGrid() {
  const grid = document.getElementById('phGrid');
  const winnersSection = document.getElementById('phWinnersSection');
  if (!grid) return;

  if (phCurrentTab === 'winners') {
    grid.style.display = 'none';
    if (winnersSection) winnersSection.style.display = 'block';
    loadWinners();
    return;
  }

  if (winnersSection) winnersSection.style.display = 'none';
  grid.style.display = 'grid';

  let filtered = phProducts.filter(p => p.category === phCurrentTab);
  if (phCurrentGroup !== 'all') {
    filtered = filtered.filter(p => p.groupId === phCurrentGroup);
  }

  if (filtered.length === 0) {
    grid.innerHTML = `<div style="grid-column:1/-1;text-align:center;padding:40px 20px;color:#bbb;">
      <i class="fa fa-mobile-screen" style="font-size:40px;display:block;margin-bottom:12px;"></i>
      <p style="font-size:14px;">لا توجد منتجات في هذا القسم</p></div>`;
    return;
  }

  grid.innerHTML = '';
  filtered.forEach(p => {
    const imgs = p.images || [];
    const firstImg = imgs[0] || '';
    const condLabel = p.category === 'used' ? 'مستعمل' : p.category === 'new' ? 'جديد' : '';
    const condClass = p.category === 'used' ? 'used' : 'new';

    // إيجاد اسم المجموعة
    const allGroups = [...(phGroups.new||[]), ...(phGroups.used||[]), ...(phGroups.accessories||[])];
    const grp = allGroups.find(g => g.id === p.groupId);
    const grpName = grp ? grp.name : '';

    const card = document.createElement('div');
    card.className = 'ph-card';
    card.onclick = () => openPhoneDetail(p.id);

    let dotsHtml = imgs.slice(0,4).map((_,i) => `<div class="ph-slider-dot${i===0?' active':''}"></div>`).join('');

    const isAdminNow = auth.currentUser && auth.currentUser.email === ADMIN_EMAIL;
    const adminCardMenu = isAdminNow ? `
      <button class="ph-card-admin-btn" onclick="event.stopPropagation();togglePhCardMenu('${p.id}')">
        <i class="fa fa-ellipsis-v"></i>
      </button>
      <div class="ph-card-admin-dropdown" id="phcmenu-${p.id}">
        <div class="ph-card-admin-item" onclick="event.stopPropagation();openEditPhoneById('${p.id}')"><i class="fa fa-edit"></i> تعديل</div>
        <div class="ph-card-admin-item danger" onclick="event.stopPropagation();deletePhoneById('${p.id}')"><i class="fa fa-trash"></i> حذف</div>
      </div>` : '';

    card.innerHTML = `
      <div class="ph-card-slider" id="phcs-${p.id}" style="position:relative;">
        ${imgs.map((src,i) => `<img src="${src}" class="${i===0?'active':''}" onerror="this.style.display='none'">`).join('')}
        ${condLabel ? `<div class="ph-condition-badge ${condClass}">${condLabel}</div>` : ''}
        ${imgs.length > 1 ? `<div class="ph-slider-dots">${dotsHtml}</div>` : ''}
        ${adminCardMenu}
      </div>
      <div class="ph-card-body">
        <div class="ph-card-name">${p.name || '—'}</div>
        <div class="ph-card-price">${p.price ? Number(p.price).toLocaleString('ar') + ' $' : '—'}</div>
        ${grpName ? `<div class="ph-card-group">${grpName}</div>` : ''}
      </div>`;

    grid.appendChild(card);

    // auto-slide للبطاقة
    if (imgs.length > 1) {
      let idx = 0;
      setInterval(() => {
        const slider = document.getElementById('phcs-' + p.id);
        if (!slider) return;
        const allImgs = slider.querySelectorAll('img');
        const allDots = slider.querySelectorAll('.ph-slider-dot');
        allImgs.forEach(i => i.classList.remove('active'));
        allDots.forEach(d => d.classList.remove('active'));
        idx = (idx + 1) % allImgs.length;
        if (allImgs[idx]) allImgs[idx].classList.add('active');
        if (allDots[idx]) allDots[idx].classList.add('active');
      }, 3000);
    }
  });
}

/* ===== تبديل التبويب ===== */
function switchPhTab(tab, el) {
  phCurrentTab = tab;
  phCurrentGroup = 'all';
  document.querySelectorAll('.ph-tab').forEach(t => t.classList.remove('active'));
