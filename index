.ph-detail-nav.next { left:10px; }
.ph-detail-close { position:absolute; top:12px; right:12px; background:rgba(0,0,0,0.45); border:none; color:white; width:34px; height:34px; border-radius:50%; font-size:15px; cursor:pointer; display:flex; align-items:center; justify-content:center; backdrop-filter:blur(4px); z-index:5; }
.ph-detail-body { padding:18px 18px 30px; }
.ph-detail-name { font-weight:900; color:var(--primary); font-size:18px; margin-bottom:6px; }
.ph-detail-price { font-weight:900; color:var(--gold); font-size:22px; margin-bottom:10px; }
.ph-detail-badges { display:flex; gap:8px; margin-bottom:14px; flex-wrap:wrap; }
.ph-detail-badge { padding:4px 12px; border-radius:20px; font-size:11px; font-weight:700; }
.ph-specs-grid { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:14px; }
.ph-spec-box { background:#f8f9fa; border-radius:12px; padding:10px 12px; }
.ph-spec-lbl { font-size:10px; color:#aaa; font-weight:700; margin-bottom:3px; }
.ph-spec-val { font-size:13px; font-weight:900; color:var(--primary); }
.ph-detail-desc { background:#f8f9fa; border-radius:14px; padding:12px 14px; font-size:13px; color:#444; line-height:1.8; margin-bottom:16px; white-space:pre-wrap; }
.ph-whatsapp-btn { width:100%; padding:14px; border:none; border-radius:14px; background:linear-gradient(135deg,#25D366,#128C7E); color:white; font-weight:900; font-family:'Cairo',sans-serif; font-size:16px; cursor:pointer; transition:all 0.3s; display:flex; align-items:center; justify-content:center; gap:10px; }
.ph-whatsapp-btn:hover { transform:translateY(-2px); box-shadow:0 8px 24px rgba(37,211,102,0.35); }
.ph-admin-del-btn { width:100%; padding:11px; border:1.5px solid rgba(233,69,96,0.3); border-radius:12px; background:#fff0f3; color:#e94560; font-family:'Cairo',sans-serif; font-weight:700; font-size:14px; cursor:pointer; margin-top:10px; display:flex; align-items:center; justify-content:center; gap:6px; }
.ph-admin-panel { background:white; border-radius:18px; padding:18px; margin-bottom:16px; box-shadow:0 4px 20px rgba(0,0,0,0.07); border-right:4px solid var(--accent); }
.ph-img-preview-list { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:8px; }
.ph-img-preview-item { position:relative; width:70px; height:70px; border-radius:10px; overflow:hidden; }
.ph-img-preview-item img { width:100%; height:100%; object-fit:cover; }
.ph-img-preview-item .rm-img { position:absolute; top:2px; left:2px; background:rgba(233,69,96,0.85); border:none; color:white; width:18px; height:18px; border-radius:50%; font-size:10px; cursor:pointer; display:flex; align-items:center; justify-content:center; }
.ph-add-img-row { display:flex; gap:8px; margin-bottom:10px; }
.ph-add-img-row input { flex:1; padding:9px 12px; border-radius:10px; border:1.5px solid #e8e8e8; font-family:'Cairo',sans-serif; font-size:13px; outline:none; }
.ph-add-img-btn { background:var(--primary); color:white; border:none; border-radius:10px; padding:9px 14px; font-family:'Cairo',sans-serif; font-weight:700; font-size:13px; cursor:pointer; white-space:nowrap; }
.winners-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-top:4px; }
.winner-card { background:white; border-radius:18px; overflow:hidden; box-shadow:0 2px 14px rgba(0,0,0,0.08); text-align:center; transition:all 0.25s; }
.winner-card:hover { transform:translateY(-3px); }
.winner-trophy { background:linear-gradient(135deg,#f39c12,#e67e22); padding:16px 12px 8px; }
.winner-avatar { width:64px; height:64px; border-radius:50%; object-fit:cover; border:3px solid white; margin:0 auto; display:block; box-shadow:0 4px 14px rgba(0,0,0,0.2); }
.winner-body { padding:10px 10px 14px; }
.winner-name { font-weight:900; color:var(--primary); font-size:14px; margin-bottom:6px; }
.winner-prize { background:#fff8e1; border:1.5px solid rgba(243,156,18,0.3); border-radius:10px; padding:6px 10px; font-size:11px; font-weight:700; color:#d68910; display:flex; align-items:center; justify-content:center; gap:5px; }
.winner-date { font-size:10px; color:#bbb; margin-top:6px; display:flex; align-items:center; justify-content:center; gap:4px; }
#addWinnerModal { display:none; position:fixed; inset:0; z-index:9997; justify-content:center; align-items:center; background:rgba(0,0,0,0.55); backdrop-filter:blur(5px); padding:20px; }
#addWinnerModal.open { display:flex; }
.add-winner-box { background:white; border-radius:24px; width:100%; max-width:420px; overflow:hidden; animation:popIn 0.3s ease; box-shadow:0 20px 60px rgba(0,0,0,0.2); }
