  document.getElementById('muteModal').classList.add('open');
}
function closeMuteMenu(){
  document.getElementById('muteModal').classList.remove('open');
  muteTargetUserId = "";
  selectedMuteDuration = "";
}
function selectMute(el, duration){
  document.querySelectorAll('.mute-option').forEach(o => o.classList.remove('selected'));
  el.classList.add('selected');
  selectedMuteDuration = duration;
}

async function applyMute(){
  if(!selectedMuteDuration){ showToast('اختر مدة التقييد أولاً','warning'); return; return; }
  if(!muteTargetUserId) return;

  const now = Date.now();
  let muteUntil = null;
  let isBan     = false;
  let isForever = false;

  if(selectedMuteDuration === 'ban'){
    isBan = true;
  } else if(selectedMuteDuration === 'forever'){
    isForever = true;
    muteUntil = new Date(now + 100 * 365 * 24 * 60 * 60 * 1000); // 100 سنة
  } else {
    const mins = { '5m':5, '10m':10, '30m':30, '24h':1440 };
    muteUntil = new Date(now + mins[selectedMuteDuration] * 60 * 1000);
  }

  const userRef = db.collection("users").doc(muteTargetUserId);

  if(isBan){
    await userRef.update({ banned: true, bannedAt: firebase.firestore.FieldValue.serverTimestamp() });
    // إشعار للمحظور
    await userRef.collection("notifications").add({
      title: "🚫 تم حظر حسابك",
      body: "تم حظر حسابك بسبب انتهاك معايير التطبيق. إذا كنت تعتقد أن هذا خطأ تواصل مع الإدارة.",
      read: false, createdAt: firebase.firestore.FieldValue.serverTimestamp(), type: "ban"
    });
  } else {
    const label = { '5m':'5 دقائق','10m':'10 دقائق','30m':'30 دقيقة','24h':'24 ساعة','forever':'بشكل دائم' };
    await userRef.update({ mutedUntil: firebase.firestore.Timestamp.fromDate(muteUntil) });
    // إشعار للمقيَّد
    await userRef.collection("notifications").add({
      title: "⚠️ تم تقييد تعليقاتك",
      body: `تم تقييدك من التعليق لمدة ${label[selectedMuteDuration]} بسبب تعليق غير مناسب.`,
      read: false, createdAt: firebase.firestore.FieldValue.serverTimestamp(), type: "mute"
    });
  }

  closeMuteMenu();
  showToast(isBan ? `تم حظر ${muteTargetName} بنجاح` : `تم تقييد ${muteTargetName} بنجاح`,'success');
}

/* ===== CHECK RESTRICTION BEFORE COMMENT ===== */
async function checkUserRestriction(){
  if(!auth.currentUser) return false;
  const doc = await db.collection("users").doc(auth.currentUser.uid).get();
  const u = doc.data();
  if(!u) return false;

  if(u.banned){
    showRestrictionBanner('ban');
    return true;
  }
  if(u.mutedUntil){
    const muteTime = u.mutedUntil.toDate ? u.mutedUntil.toDate() : new Date(u.mutedUntil);
    if(new Date() < muteTime){
      showRestrictionBanner('mute', muteTime);
      return true;
    }
  }
  return false;
}

function showRestrictionBanner(type, until){
  const banner = document.getElementById('restrictionBanner');
  const icon   = document.getElementById('restrictionIcon');
  const title  = document.getElementById('restrictionTitle');
  const msg    = document.getElementById('restrictionMsg');

  if(type === 'ban'){
    icon.className  = 'restriction-icon banned';
    icon.innerHTML  = '<i class="fa fa-ban"></i>';
    title.textContent = '🚫 تم حظر حسابك';
    msg.textContent   = 'تم حظر حسابك بسبب انتهاك معايير التطبيق. لا يمكنك التعليق أو التفاعل.';
  } else {
    const timeStr = until ? until.toLocaleTimeString('ar-EG',{hour:'2-digit',minute:'2-digit'}) : '';
    icon.className  = 'restriction-icon muted';
    icon.innerHTML  = '<i class="fa fa-comment-slash"></i>';
    title.textContent = '⚠️ تم تقييد تعليقاتك';
    msg.textContent   = `تم تقييدك من التعليق بسبب تعليق غير مناسب. يمكنك التعليق مجدداً بعد ${timeStr}.`;
  }
  banner.classList.add('show');
}

