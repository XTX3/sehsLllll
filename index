async function searchMember(){
  if(!requireLogin()) return;
  const val = document.getElementById('searchInput').value.trim();
  if(!val){ showSearchError("يرجى إدخال الكود أو البريد الإلكتروني"); return; }

  document.getElementById('transferStep1').style.display = 'none';
  document.getElementById('searchError').style.display = 'none';
  document.getElementById('searchingIndicator').style.display = 'block';

  // جلب كل المستخدمين والبحث محلياً لتجنب مشاكل Firestore index/rules
  try {
    const allUsers = await db.collection("users").get();

    document.getElementById('searchingIndicator').style.display = 'none';

    if(allUsers.empty){
      document.getElementById('transferStep1').style.display = 'block';
      showSearchError("لا يوجد أعضاء مسجلون");
      return;
    }

    let foundDoc = null;
    const searchVal = val.trim().toLowerCase();

    allUsers.forEach(doc => {
      if(foundDoc) return;
      const u = doc.data();
      const codeMatch  = u.topupCode && u.topupCode.toLowerCase() === searchVal;
      const emailMatch = u.email     && u.email.toLowerCase()     === searchVal;
      if(codeMatch || emailMatch) foundDoc = doc;
    });

    if(!foundDoc){
      document.getElementById('transferStep1').style.display = 'block';
      showSearchError("لم يتم العثور على عضو بهذا الكود أو البريد");
      return;
    }

    if(foundDoc.id === auth.currentUser.uid){
      document.getElementById('transferStep1').style.display = 'block';
      showSearchError("لا يمكنك التحويل لنفسك");
      return;
    }

    foundUserId   = foundDoc.id;
    foundUserData = foundDoc.data();

    const photo = foundUserData.photo || (foundUserData.gender==="male"
      ? "https://cdn-icons-png.flaticon.com/512/3135/3135715.png"
      : "https://cdn-icons-png.flaticon.com/512/3135/3135789.png");

    document.getElementById('foundUserPhoto').src         = photo;
    document.getElementById('foundUserName').textContent  = foundUserData.name;
    document.getElementById('foundUserEmail').textContent = foundUserData.email;
    document.getElementById('foundUserRole').textContent  = foundUserData.role || 'user';
    document.getElementById('foundUserBalance').textContent = (foundUserData.balance || '0.000') + ' $';
    document.getElementById('foundUserCode').textContent    = foundUserData.topupCode || '—';
    document.getElementById('transferStep2').style.display = 'block';

  } catch(err){
    document.getElementById('searchingIndicator').style.display = 'none';
    document.getElementById('transferStep1').style.display = 'block';
    showSearchError("خطأ في الاتصال: " + err.message);
  }
}

function showSearchError(msg){
  const el = document.getElementById('searchError');
  el.textContent = msg; el.style.display = 'block';
}

async function doTransfer(){
  if(!requireLogin()) return;
  const amountStr = document.getElementById('transferAmount').value.trim();
  const amount    = Math.round(parseFloat(amountStr) * 1000) / 1000;

  if(!amount || amount <= 0 || isNaN(amount)){
    showToast('يرجى إدخال مبلغ صحيح أكبر من صفر','warning'); return;
    return;
  }
  if(!foundUserId) return;
  if(foundUserId === auth.currentUser.uid){
    showToast('لا يمكنك التحويل لنفسك','warning'); return;
    return;
  }

  const senderRef   = db.collection('users').doc(auth.currentUser.uid);
  const receiverRef = db.collection('users').doc(foundUserId);

  try {
    let newSenderBal, newReceiverBal, senderName, receiverName;

    await db.runTransaction(async tx => {
      const senderSnap   = await tx.get(senderRef);
      const receiverSnap = await tx.get(receiverRef);

      if(!senderSnap.exists)   throw new Error('حسابك غير موجود');
      if(!receiverSnap.exists) throw new Error('حساب المستقبل غير موجود');

      const senderData   = senderSnap.data();
      const receiverData = receiverSnap.data();

      const senderBal   = Math.round(parseFloat(senderData.balance   || '0') * 1000) / 1000;
      const receiverBal = Math.round(parseFloat(receiverData.balance || '0') * 1000) / 1000;

      if(isNaN(senderBal))   throw new Error('رصيدك غير صالح');
      if(amount > senderBal) throw new Error(`رصيدك غير كافٍ — رصيدك الحالي: ${senderBal.toFixed(3)} $`);

      newSenderBal   = Math.round((senderBal   - amount) * 1000) / 1000;
      newReceiverBal = Math.round((receiverBal + amount) * 1000) / 1000;

      if(newSenderBal < 0) throw new Error('خطأ في حساب الرصيد');

      senderName   = senderData.name   || auth.currentUser.email;
      receiverName = receiverData.name || foundUserData?.email || '—';

      tx.update(senderRef,   { balance: newSenderBal.toFixed(3)   });
      tx.update(receiverRef, { balance: newReceiverBal.toFixed(3) });
    });

    const now = firebase.firestore.FieldValue.serverTimestamp();

    // إشعار للمستقبل
    await db.collection('users').doc(foundUserId).collection('notifications').add({
      title    : '💸 تحويل رصيد جديد',
      body     : `تم استلام ${amount.toFixed(3)} $ من ${senderName}. رصيدك الجديد: ${newReceiverBal.toFixed(3)} $`,
      read     : false,
      shown    : false,
      createdAt: now,
      type     : 'transfer'
    });

    // إشعار للمرسل
    await db.collection('users').doc(auth.currentUser.uid).collection('notifications').add({
      title    : '✅ تم التحويل بنجاح',
      body     : `تم تحويل ${amount.toFixed(3)} $ إلى ${receiverName}. رصيدك الجديد: ${newSenderBal.toFixed(3)} $`,
      read     : false,
      shown    : false,
      createdAt: now,
      type     : 'transfer_sent'
    });

    // تحديث الشريط العلوي فوراً
    document.getElementById('topbarBalance').textContent = newSenderBal.toFixed(3);

    // إظهار نجاح
    document.getElementById('transferStep2').style.display  = 'none';
    document.getElementById('successMsg').textContent = `تم تحويل ${amount.toFixed(3)} $ إلى ${receiverName} بنجاح ✨`;
    document.getElementById('transferSuccess').style.display = 'block';

  } catch(err){
    showToast(err.message||'حدث خطأ، يرجى المحاولة مرة أخرى','error');
  }
}

/* ===== إعادة تعيين رصيد المسوال كل ساعة ===== */
function checkAdminBalance(uid){
  const adminRef = db.collection("users").doc(uid);
  adminRef.get().then(doc => {
    if(!doc.exists) return;
    const u = doc.data();
    if(u.role !== "admin") return;

    const now = Date.now();
    const lastReset = u.lastBalanceReset ? u.lastBalanceReset.toMillis() : 0;
    const oneHour = 60 * 60 * 1000;

    // إذا مضت ساعة أو أكثر → أعد الرصيد إلى مليون
    if(now - lastReset >= oneHour){
      adminRef.update({
        balance: "1000000.000",
        lastBalanceReset: firebase.firestore.FieldValue.serverTimestamp()
      });
    }
  });
}

