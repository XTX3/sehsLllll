      <button onclick="closeDepositModal()" style="background:#f5f5f5;border:none;width:34px;height:34px;border-radius:50%;font-size:15px;cursor:pointer;display:flex;align-items:center;justify-content:center;color:#555;">
        <i class="fa fa-times"></i>
      </button>
    </div>

    <!-- طرق الإيداع -->
    <div class="deposit-methods-grid">
      <div class="deposit-method-btn active" onclick="selectDepMethod('shamcash',this)">
        <span class="dm-icon" style="font-size:0;">
          <img src="https://l.top4top.io/p_3721tlczs1.png" alt="شام كاش"
               style="height:40px;object-fit:contain;border-radius:8px;">
        </span>
        <div class="dm-name">شام كاش</div>
      </div>
      <div class="deposit-method-btn disabled">
        <span class="dm-icon">💰</span>
        <div class="dm-name">حوالة مالية</div>
        <div class="dm-soon">قريباً</div>
      </div>
      <div class="deposit-method-btn disabled">
        <span class="dm-icon">📱</span>
        <div class="dm-name">بابرا</div>
        <div class="dm-soon">قريباً</div>
      </div>
      <div class="deposit-method-btn disabled">
        <span class="dm-icon">🏦</span>
        <div class="dm-name">حساب بنكي</div>
        <div class="dm-soon">قريباً</div>
      </div>
    </div>

    <!-- فورم شام كاش -->
    <div class="dep-shamcash-form open" id="depShamcashForm">

      <!-- شعار شام كاش -->
      <div style="text-align:center;margin-bottom:14px;">
        <img src="https://l.top4top.io/p_3721tlczs1.png" alt="شام كاش"
             style="height:54px;object-fit:contain;border-radius:12px;">
      </div>

      <!-- اختيار العملة -->
      <div class="dep-section-title"><i class="fa fa-coins"></i> اختر العملة</div>
      <div class="dep-currency-tabs">
        <div class="dep-currency-tab active" onclick="selectDepCurrency('usd',this)">🇺🇸 دولار أمريكي</div>
        <div class="dep-currency-tab" onclick="selectDepCurrency('syp',this)"><img src="https://flagcdn.com/w20/sy.png" style="height:14px;vertical-align:middle;margin-left:4px;border-radius:2px;"> ليرة سورية</div>
      </div>

      <!-- المبلغ -->
      <div class="dep-input-group">
        <label class="dep-input-label"><i class="fa fa-coins" style="color:var(--highlight);margin-left:4px;"></i> المبلغ المراد إيداعه</label>
        <input class="dep-input" id="depAmount" type="number" min="0.001" step="0.001" placeholder="0.000" oninput="onDepAmountChange()">
      </div>

      <!-- صندوق المبلغ النهائي بالدولار (للقراءة فقط) -->
      <div id="depFinalBox" style="display:none;background:linear-gradient(135deg,var(--primary),var(--accent));border-radius:14px;padding:14px 16px;margin-bottom:14px;text-align:center;">
        <div style="color:rgba(255,255,255,0.6);font-size:11px;font-weight:700;margin-bottom:4px;">سيُضاف إلى رصيدك</div>
        <div id="depFinalUsd" style="color:var(--highlight);font-size:26px;font-weight:900;font-family:monospace;">0.000 $</div>
        <div id="depFinalNote" style="color:rgba(255,255,255,0.5);font-size:11px;margin-top:3px;"></div>
      </div>

      <!-- كود التحويل -->
      <div class="dep-section-title">
        <i class="fa fa-send"></i> أرسل المبلغ على هذا الكود
        <button id="depEditCodeBtn" onclick="toggleDepEditCode()" style="display:none;margin-right:auto;background:rgba(0,212,170,0.12);border:1px solid rgba(0,212,170,0.3);border-radius:8px;padding:3px 10px;font-size:11px;font-weight:700;color:var(--highlight);cursor:pointer;font-family:Cairo,sans-serif;">
          <i class="fa fa-pen"></i> تعديل الكود
        </button>
      </div>
      <div class="dep-code-box" style="flex-direction:column;align-items:stretch;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
          <div class="code-label" style="margin-bottom:0;">كود شام كاش للإيداع</div>
          <button class="dep-code-copy" onclick="copyDepCode()" style="flex-shrink:0;"><i class="fa fa-copy"></i> نسخ</button>
        </div>
        <div style="overflow-x:auto;white-space:nowrap;padding-bottom:4px;">
          <div class="code-val" id="depShamcashCode" style="display:inline-block;white-space:nowrap;">جاري التحميل...</div>
        </div>
      </div>
      <!-- حقل تعديل الكود - للأدمن فقط -->
      <div id="depEditCodeWrap" style="display:none;margin-bottom:12px;">
        <div style="display:flex;gap:8px;">
          <input id="depNewCode" class="dep-input" placeholder="أدخل الكود الجديد..." style="margin-bottom:0;flex:1;">
          <button onclick="saveNewDepCode()" style="background:linear-gradient(135deg,#16a085,#1abc9c);border:none;border-radius:12px;padding:0 16px;color:white;font-weight:900;font-family:Cairo,sans-serif;font-size:13px;cursor:pointer;white-space:nowrap;">
            <i class="fa fa-save"></i> حفظ
          </button>
        </div>
        <div style="font-size:11px;color:#aaa;margin-top:5px;font-weight:600;">
          <i class="fa fa-info-circle"></i> هذا الكود سيظهر لجميع المستخدمين عند الإيداع
        </div>
      </div>

      <!-- حقل تعديل سعر الصرف - للأدمن فقط -->
      <div id="depRateWrap" style="display:none;margin-bottom:12px;">
        <div class="dep-section-title" style="margin-top:0;margin-bottom:8px;">
          <i class="fa fa-exchange-alt" style="color:#f39c12;"></i> سعر الصرف الحالي
          <span id="depRateDisplay" style="margin-right:auto;font-size:12px;color:#f39c12;font-weight:900;background:rgba(243,156,18,0.1);border-radius:8px;padding:2px 8px;"></span>
        </div>
        <div style="display:flex;gap:8px;align-items:center;">
          <div style="flex:1;">
            <input id="depNewRate" type="number" class="dep-input" placeholder="مثال: 11500" style="margin-bottom:0;">
          </div>
          <div style="color:#888;font-size:12px;font-weight:700;white-space:nowrap;">ل.س = 1 $</div>
          <button onclick="saveNewDepRate()" style="background:linear-gradient(135deg,#f39c12,#e67e22);border:none;border-radius:12px;padding:0 14px;height:44px;color:white;font-weight:900;font-family:Cairo,sans-serif;font-size:13px;cursor:pointer;white-space:nowrap;">
            <i class="fa fa-save"></i> حفظ
          </button>
        </div>
        <div style="font-size:11px;color:#aaa;margin-top:5px;font-weight:600;">
          <i class="fa fa-info-circle"></i> يؤثر مباشرة على حساب قيمة الليرة السورية لجميع المستخدمين
        </div>
      </div>

      <!-- بيانات الحوالة -->
      <div class="dep-section-title"><i class="fa fa-file-alt"></i> بيانات الحوالة</div>

      <div class="dep-input-group">
        <label class="dep-input-label"><i class="fa fa-hashtag" style="color:#888;margin-left:4px;"></i> رقم الحوالة</label>
        <input class="dep-input" id="depTxId" placeholder="أدخل رقم الحوالة التي أرسلتها...">
      </div>
      <div class="dep-input-group">
        <label class="dep-input-label"><i class="fa fa-user" style="color:#888;margin-left:4px;"></i> اسم الحساب المُرسِل</label>
        <input class="dep-input" id="depSenderName" placeholder="الاسم الذي أرسلت منه...">
      </div>

      <button class="dep-submit-btn" id="depSubmitBtn" onclick="submitDeposit()">
        <i class="fa fa-paper-plane"></i> إرسال طلب الإيداع
      </button>
    </div>
  </div>
</div>

<!-- ===== نافذة طلبات الإيداع (أدمن) ===== -->
<div id="depositRequestsPanel">
  <div class="dep-req-box">
    <div class="modal-drag"></div>
    <div class="dep-req-header">
      <h4><i class="fa fa-wallet" style="color:#16a085;"></i> طلبات الإيداع</h4>
      <button onclick="closeDepositRequests()" style="background:#f5f5f5;border:none;width:34px;height:34px;border-radius:50%;font-size:15px;cursor:pointer;display:flex;align-items:center;justify-content:center;color:#555;">
        <i class="fa fa-times"></i>
      </button>
    </div>
    <div id="depositRequestsList">
      <div class="notif-empty"><i class="fa fa-inbox"></i><br>لا توجد طلبات إيداع</div>
    </div>
  </div>
</div>

<!-- نافذة يجب تسجيل الدخول -->
<div id="loginRequiredModal">
  <div class="login-required-box">
    <div class="login-required-top">
      <div class="login-required-icon"><i class="fa fa-lock"></i></div>
      <h3>يجب تسجيل الدخول</h3>
      <p id="loginRequiredMsg">سجّل دخولك للتفاعل مع التطبيق والاستمتاع بكامل الميزات</p>
    </div>
    <div class="login-required-bottom">
      <button class="btn-go-login" onclick="goToLogin()">
        <i class="fa fa-sign-in-alt"></i> تسجيل الدخول
      </button>
      <button class="btn-go-register" onclick="goToRegister()">
        <i class="fa fa-user-plus"></i> إنشاء حساب جديد
      </button>
      <button class="btn-cancel-login" onclick="closeLoginRequired()">إلغاء</button>
    </div>
  </div>
</div>

<!-- نافذة إدارة المشرفين -->
<div id="moderatorPanel">
  <div class="mod-box">
    <div class="mod-header">
      <h3><i class="fa fa-shield-halved"></i> إدارة المشرفين</h3>
      <button class="mod-close-btn" onclick="closeModeratorPanel()"><i class="fa fa-times"></i></button>
    </div>
    <div class="mod-body">
      <p style="font-size:12px;color:#888;margin-bottom:12px;line-height:1.6;">
        المشرف يمكنه نشر أخبار ومراجعة طلبات المتجر. لا يمكنه تحويل رصيد أو نشر منتجات.
      </p>
      <div class="mod-search-row">
        <input id="modSearchInput" placeholder="البريد الإلكتروني أو كود الشحن...">
        <button class="mod-search-btn" onclick="searchForModerator()"><i class="fa fa-search"></i> بحث</button>
      </div>
      <div id="modSearchResult" style="display:none;"></div>
      <div class="mod-list-title"><i class="fa fa-users" style="color:#9b59b6;"></i> المشرفون الحاليون</div>
      <div id="modList"><div class="notif-empty"><i class="fa fa-spinner fa-spin"></i></div></div>
    </div>
  </div>
</div>
</body>
</html>
