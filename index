function toggleScMenu(pid) {
  const btn = document.querySelector(`[onclick="event.stopPropagation();toggleScMenu('${pid}')"]`);
  const menu = document.getElementById('scmenu-' + pid);
  const isOpen = menu && menu.classList.contains('open');
  closeAllScMenus();
  if (menu && !isOpen && btn) {
    const rect = btn.getBoundingClientRect();
    const menuW = 140;
    const winH  = window.innerHeight;
    const spaceBelow = winH - rect.bottom;
    const menuH = 120; // ارتفاع تقريبي للقائمة
    let top, left;
    if (spaceBelow < menuH + 10) {
      // لا يكفي مكان تحت - أظهرها فوق الزر
      top = rect.top - menuH - 4;
    } else {
      top = rect.bottom + 4;
    }
    left = rect.left;
    // لا تخرج من يمين الشاشة
    if (left + menuW > window.innerWidth) left = window.innerWidth - menuW - 8;
    menu.style.top  = top + 'px';
    menu.style.left = left + 'px';
    menu.classList.add('open');
    setTimeout(() => {
      document.addEventListener('click', function closeOnClick(e) {
        if (!e.target.closest('.sc-admin-toggle') && !e.target.closest('.sc-admin-menu')) {
          closeAllScMenus();
          document.removeEventListener('click', closeOnClick);
        }
      });
    }, 10);
  }
}

function closeAllScMenus() {
  document.querySelectorAll('.sc-admin-menu.open').forEach(m => m.classList.remove('open'));
}


