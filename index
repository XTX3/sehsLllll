async function publishPhone() {
  if (!auth.currentUser || auth.currentUser.email !== ADMIN_EMAIL) { showToast('للأدمن فقط','warning'); return; return; }
  const name     = document.getElementById('phName').value.trim();
  const price    = document.getElementById('phPrice').value.trim();
  const category = document.getElementById('phCategory').value;
  const groupId  = document.getElementById('phGroup').value;
  const whatsapp = document.getElementById('phWhatsapp').value.trim();

  if (!name)  { showToast('أدخل اسم الجهاز','warning'); return; return; }
  if (!price) { showToast('أدخل السعر','warning'); return; return; }
  if (phAddImages.length === 0) { showToast('أضف صورة واحدة على الأقل','warning'); return; return; }

  const data = {
    name, price: parseFloat(price), category, groupId, whatsapp,
    ram:       document.getElementById('phRam').value.trim(),
    storage:   document.getElementById('phStorage').value.trim(),
    screen:    document.getElementById('phScreen').value.trim(),
    battery:   document.getElementById('phBattery').value.trim(),
    camera:    document.getElementById('phCamera').value.trim(),
    processor: document.getElementById('phProcessor').value.trim(),
    description: document.getElementById('phDesc').value.trim(),
    images:    phAddImages,
  };

  try {
    if (editingPhoneId) {
      // وضع التعديل
      await db.collection('phoneProducts').doc(editingPhoneId).update(data);
      editingPhoneId = null;
      showToast('تم حفظ التعديلات!','success');
    } else {
      // وضع الإضافة
      if (!whatsapp) { showToast('أدخل رقم الواتساب','warning'); return; return; }
      data.createdAt = firebase.firestore.FieldValue.serverTimestamp();
      data.createdBy = auth.currentUser.uid;
      await db.collection('phoneProducts').add(data);
      showToast('تم نشر الجهاز بنجاح!','success');
    }
    // تنظيف
    ['phName','phPrice','phRam','phStorage','phScreen','phBattery','phCamera','phProcessor','phDesc','phWhatsapp'].forEach(id => {
      const el = document.getElementById(id); if(el) el.value = '';
    });
    phAddImages = [];
    renderPhImgPreviews();
    closeAddPhonePanel();
  } catch(err) { showToast('خطأ: ' + err.message,'error'); }
}

