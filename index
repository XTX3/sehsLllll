async function approveDeposit(reqId, uid, amountDisplay) {
  // قراءة المبلغ الفعلي من حقل الأدمن
  const realAmtInput = document.getElementById('dep-real-amt-' + reqId);
  const realAmt = Math.round(parseFloat(realAmtInput ? realAmtInput.value : 0) * 1000) / 1000;
  if (!realAmt || realAmt <= 0) { showToast('أدخل المبلغ الفعلي الذي وصلك','warning'); return; }

  if(!await showConfirm('تأكيد الموافقة', 'سيتم إضافة ' + realAmt.toFixed(3) + ' $ لرصيد العضو', '💰', 'إضافة الرصيد', true)) return;

  const reqRef  = db.collection('depositRequests').doc(reqId);
  const userRef = db.collection('users').doc(uid);
  try {
    let newBalance;
    await db.runTransaction(async tx => {
      const reqSnap  = await tx.get(reqRef);
      const userSnap = await tx.get(userRef);
      if (!reqSnap.exists)  throw new Error('الطلب غير موجود');
      if (reqSnap.data().status !== 'pending') throw new Error('الطلب تمت معالجته مسبقاً');
      if (!userSnap.exists) throw new Error('المستخدم غير موجود');
      const curBal = Math.round(parseFloat(userSnap.data().balance || '0') * 1000) / 1000;
      newBalance = Math.round((curBal + realAmt) * 1000) / 1000;
      tx.update(reqRef, {
        status: 'approved',
        approvedAt: firebase.firestore.FieldValue.serverTimestamp(),
        actualAmountAdded: realAmt
      });
      tx.update(userRef, { balance: newBalance.toFixed(3) });
    });
    await db.collection('users').doc(uid).collection('notifications').add({
      title    : '✅ تم قبول طلب الإيداع',
      body     : `تمت الموافقة على إيداع ${realAmt.toFixed(3)} $. رصيدك الجديد: ${newBalance.toFixed(3)} $`,
      read     : false, shown: false,
      createdAt: firebase.firestore.FieldValue.serverTimestamp(),
      type     : 'deposit_approved'
    });
    showToast('تمت إضافة ' + realAmt.toFixed(3) + ' $ لرصيد العضو', 'success');
  } catch(e) { showToast('خطأ: ' + e.message,'error'); }
}

async function rejectDeposit(reqId, uid, amountDisplay) {
  const reason = document.getElementById('dep-rjt-' + reqId)?.value.trim();
  if (!reason) { showToast('يرجى كتابة سبب الرفض','warning'); return; return; }
  if(!await showConfirm('تأكيد الرفض','هل تريد رفض طلب الإيداع؟','❌','رفض')) return;
  const reqRef = db.collection('depositRequests').doc(reqId);
  try {
    await db.runTransaction(async tx => {
      const snap = await tx.get(reqRef);
      if (!snap.exists) throw new Error('الطلب غير موجود');
      if (snap.data().status !== 'pending') throw new Error('تمت معالجة الطلب مسبقاً');
      tx.update(reqRef, { status:'rejected', rejectReason: reason, rejectedAt: firebase.firestore.FieldValue.serverTimestamp() });
    });
    await db.collection('users').doc(uid).collection('notifications').add({
      title    : '❌ تم رفض طلب الإيداع',
      body     : `تم رفض طلب إيداع ${amountDisplay}. السبب: ${reason}`,
      read     : false, shown: false,
      createdAt: firebase.firestore.FieldValue.serverTimestamp(),
      type     : 'deposit_rejected'
    });
  } catch(e) { showToast('خطأ: ' + e.message,'error'); }
}

